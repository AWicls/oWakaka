// 左侧会话栏：SessionItem 数据源 + SessionRow 行 + SessionSidebar 卡片
//（含左下角主题切换按钮与弹出菜单）。

import { ScrollView } from "std-widgets.slint";
import { Theme, Icon, IconKind, OptionRow } from "theme.slint";

/// 侧栏一行数据源：会话标题 + 是否选中。
export struct SessionItem {
    title: string,
    active: bool,
}

/// 侧栏列表的一行：圆角条，选中/悬停高亮，超长标题省略号；悬停右侧现 ✕ 删除。
component SessionRow inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback row-clicked();
    callback delete-clicked();

    height: 38px;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            // 悬停 ✕ 无独立 TouchArea（嵌套事件归属不可靠），按坐标分区：右缘 26px = 删除
            if (ta.mouse-x >= parent.width - 26px) {
                root.delete-clicked();
            } else {
                root.row-clicked();
            }
        }
    }
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 9px;
        background: root.active ? Theme.p.listActive : (ta.has-hover ? Theme.p.listHover : transparent);
        Text {
            x: 10px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 40px;
            text: root.title;
            color: root.active ? Theme.p.textPrimary : Theme.p.textSecondary;
            font-size: 13px;
            overflow: elide;
        }
        // 删除叉号：复用 Icon cross（✕ 字形在默认字体缺字成豆腐块）；悬停才实例化
        if ta.has-hover : Icon {
            width: 14px;
            height: 14px;
            x: parent.width - 22px;
            y: (parent.height - self.height) / 2;
            kind: IconKind.cross;
            ink: Theme.p.textMuted;
        }
    }
}

/// 左侧会话栏卡片：顶部「开始新对话」，中部会话列表可滚动，底部主题/设置按钮行。
export component SessionSidebar inherits Rectangle {
    in property <[SessionItem]> sessions;
    in property <int> trash-count; // 回收站条目数（>0 时按钮高亮）
    callback new-clicked();
    callback row-clicked(int);
    callback session-delete(int); // 行 ✕：逻辑删除 → 回收站
    callback trash-clicked(); // 打开回收站浮层
    callback settings-clicked(); // 进入程序内设置整页

    background: Theme.p.panelBg;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.p.panelBorder;
    clip: true;

    property <bool> menu-open: false;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        new-btn := Rectangle {
            height: 36px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.p.inputBorder;
            background: nt.has-hover ? Theme.p.listHover : transparent;
            nt := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.new-clicked(); }
            }
            Text {
                width: parent.width;
                y: (parent.height - self.height) / 2;
                text: "+ 开始新对话";
                color: Theme.p.textPrimary;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 2px;
                for s[index] in root.sessions: SessionRow {
                    title: s.title;
                    active: s.active;
                    row-clicked => { root.row-clicked(index); }
                    delete-clicked => { root.session-delete(index); }
                }
            }
        }

        // —— 左下角按钮行：程序内设置 + 主题切换 + 回收站图标 ——
        bottom-row := HorizontalLayout {
            spacing: 4px;
            height: 34px;
            Rectangle {
                width: 40px;
                height: 34px;
                border-radius: 8px;
                background: stb.has-hover ? Theme.p.listHover : transparent;
                stb := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.settings-clicked(); }
                }
                Icon {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    kind: IconKind.sliders;
                    ink: Theme.p.textSecondary;
                }
            }
            theme-btn := Rectangle {
                width: 40px;
                height: 34px;
                border-radius: 8px;
                background: tb.has-hover ? Theme.p.listHover : transparent;
                tb := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.menu-open = !root.menu-open; }
                }
                Icon {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    kind: Theme.mode == 0 ? IconKind.sun
                        : Theme.mode == 1 ? IconKind.moon : IconKind.monitor;
                    ink: Theme.p.textSecondary;
                }
            }
            // 回收站入口（垃圾桶图元；有删剩会话时右侧显计数并高亮）
            Rectangle {
                width: root.trash-count > 0 ? 54px : 40px;
                height: 34px;
                border-radius: 8px;
                background: ttb.has-hover ? Theme.p.listHover
                        : (root.trash-count > 0 ? Theme.p.accentSoftBg : transparent);
                ttb := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.trash-clicked(); }
                }
                Icon {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    kind: IconKind.trash;
                    ink: root.trash-count > 0 ? Theme.p.link : Theme.p.textSecondary;
                }
                if root.trash-count > 0 : Text {
                    x: 33px;
                    y: (parent.height - self.height) / 2;
                    text: "" + root.trash-count;
                    color: Theme.p.link;
                    font-size: 11px;
                }
            }
            Rectangle { } // 左对齐，余量吃掉在右
        }
    }

    // 弹层遮罩：点击空白处关闭（覆盖全栏，位于弹层下方）
    Rectangle {
        visible: root.menu-open;
        width: parent.width;
        height: parent.height;
        TouchArea { clicked => { root.menu-open = false; } }
    }

    // 主题菜单弹层：锚定左下角按钮行上方
    Rectangle {
        visible: root.menu-open;
        x: 10px;
        y: bottom-row.y - self.height - 4px;
        width: 150px;
        height: 3 * 34px + 12px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.p.inputBorder;
        background: Theme.p.panelBg;

        VerticalLayout {
            padding: 6px;
            spacing: 0;
            OptionRow {
                row-height: 34px;
                icon: IconKind.sun;
                label: "浅色";
                selected: Theme.mode == 0;
                picked => {
                    Theme.mode = 0;
                    root.menu-open = false;
                }
            }
            OptionRow {
                row-height: 34px;
                icon: IconKind.moon;
                label: "深色";
                selected: Theme.mode == 1;
                picked => {
                    Theme.mode = 1;
                    root.menu-open = false;
                }
            }
            OptionRow {
                row-height: 34px;
                icon: IconKind.monitor;
                label: "跟随系统";
                selected: Theme.mode == 2;
                picked => {
                    Theme.mode = 2;
                    root.menu-open = false;
                }
            }
        }
    }
}
