// 左侧会话栏：SessionItem 数据源 + SessionRow 行 + SessionSidebar 卡片
//（含左下角主题切换按钮与弹出菜单）。

import { ScrollView } from "std-widgets.slint";
import { Theme, Icon } from "theme.slint";

/// 侧栏一行数据源：会话标题 + 是否选中。
export struct SessionItem {
    title: string,
    active: bool,
}

/// 侧栏列表的一行：圆角条，选中/悬停高亮，超长标题省略号；悬停右侧现 ✕ 删除。
component SessionRow inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback row-clicked();
    callback delete-clicked();

    height: 38px;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            // 悬停 ✕ 无独立 TouchArea（嵌套事件归属不可靠），按坐标分区：右缘 26px = 删除
            if (ta.mouse-x >= parent.width - 26px) {
                root.delete-clicked();
            } else {
                root.row-clicked();
            }
        }
    }
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 9px;
        background: root.active ? Theme.p.listActive : (ta.has-hover ? Theme.p.listHover : transparent);
        Text {
            x: 10px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 40px;
            text: root.title;
            color: root.active ? Theme.p.textPrimary : Theme.p.textSecondary;
            font-size: 13px;
            overflow: elide;
        }
        // 删除叉号图元自绘（✕ 字形在默认字体缺字，渲染成豆腐块）
        Path {
            visible: ta.has-hover;
            width: 10px;
            height: 10px;
            x: parent.width - 21px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: Theme.p.textMuted;
            stroke-width: 1.2px;
            fill: transparent;
            commands: "M1,1 L9,9 M9,1 L1,9";
        }
    }
}

/// 主题弹层的一行：图标 + 文案 + 选中态对勾。
component ThemeOption inherits Rectangle {
    in property <int> icon;
    in property <string> label;
    in property <bool> selected;
    callback picked();

    height: 34px;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Rectangle {
        x: 3px;
        y: 2px;
        width: parent.width - 6px;
        height: parent.height - 4px;
        border-radius: 7px;
        background: ta.has-hover ? Theme.p.listHover : transparent;
        Icon {
            x: 9px;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            which: root.icon;
            ink: root.selected ? Theme.p.link : Theme.p.textSecondary;
        }
        Text {
            x: 33px;
            y: (parent.height - self.height) / 2;
            text: root.label;
            color: Theme.p.textPrimary;
            font-size: 13px;
        }
        Icon {
            visible: root.selected;
            width: 14px;
            height: 14px;
            x: parent.width - self.width - 10px;
            y: (parent.height - self.height) / 2;
            which: 3; // 对勾
            ink: Theme.p.link;
        }
    }
}

/// 左侧会话栏卡片：顶部「开始新对话」，中部会话列表可滚动，底部主题/设置按钮行。
export component SessionSidebar inherits Rectangle {
    in property <[SessionItem]> sessions;
    in property <int> trash-count; // 回收站条目数（>0 时按钮高亮）
    callback new-clicked();
    callback row-clicked(int);
    callback session-delete(int); // 行 ✕：逻辑删除 → 回收站
    callback trash-clicked(); // 打开回收站浮层
    callback settings-clicked(); // 进入程序内设置整页

    background: Theme.p.panelBg;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.p.panelBorder;
    clip: true;

    property <bool> menu-open: false;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        new-btn := Rectangle {
            height: 36px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.p.inputBorder;
            background: nt.has-hover ? Theme.p.listHover : transparent;
            nt := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.new-clicked(); }
            }
            Text {
                width: parent.width;
                y: (parent.height - self.height) / 2;
                text: "+ 开始新对话";
                color: Theme.p.textPrimary;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 2px;
                for s[index] in root.sessions: SessionRow {
                    title: s.title;
                    active: s.active;
                    row-clicked => { root.row-clicked(index); }
                    delete-clicked => { root.session-delete(index); }
                }
            }
        }

        // —— 左下角按钮行：主题切换 + 程序内设置 ——
        bottom-row := HorizontalLayout {
            spacing: 4px;
            height: 34px;
            theme-btn := Rectangle {
                width: 40px;
                height: 34px;
                border-radius: 8px;
                background: tb.has-hover ? Theme.p.listHover : transparent;
                tb := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.menu-open = !root.menu-open; }
                }
                Icon {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    // 0 太阳 | 1 月亮 | 2 跟随系统
                    which: Theme.mode == 0 ? 0 : Theme.mode == 1 ? 1 : 2;
                    ink: Theme.p.textSecondary;
                }
            }
            Rectangle {
                width: 40px;
                height: 34px;
                border-radius: 8px;
                background: stb.has-hover ? Theme.p.listHover : transparent;
                stb := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.settings-clicked(); }
                }
                Icon {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    which: 5; // 设置滑杆
                    ink: Theme.p.textSecondary;
                }
            }
            // 回收站入口（有删剩会话时显示计数并高亮）
            Rectangle {
                width: trash-lbl.preferred-width + 16px;
                height: 34px;
                border-radius: 8px;
                background: ttb.has-hover ? Theme.p.listHover
                        : (root.trash-count > 0 ? Theme.p.accentSoftBg : transparent);
                ttb := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.trash-clicked(); }
                }
                trash-lbl := Text {
                    x: 8px;
                    y: (parent.height - self.height) / 2;
                    text: root.trash-count > 0 ? "回收站 " + root.trash-count : "回收站";
                    color: root.trash-count > 0 ? Theme.p.link : Theme.p.textMuted;
                    font-size: 12px;
                }
            }
            Rectangle { } // 左对齐，余量吃掉在右
        }
    }

    // 弹层遮罩：点击空白处关闭（覆盖全栏，位于弹层下方）
    Rectangle {
        visible: root.menu-open;
        width: parent.width;
        height: parent.height;
        TouchArea { clicked => { root.menu-open = false; } }
    }

    // 主题菜单弹层：锚定左下角按钮行上方
    Rectangle {
        visible: root.menu-open;
        x: 10px;
        y: bottom-row.y - self.height - 4px;
        width: 150px;
        height: 3 * 34px + 12px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.p.inputBorder;
        background: Theme.p.panelBg;

        VerticalLayout {
            padding: 6px;
            spacing: 0;
            ThemeOption {
                icon: 0;
                label: "浅色";
                selected: Theme.mode == 0;
                picked => {
                    Theme.mode = 0;
                    root.menu-open = false;
                }
            }
            ThemeOption {
                icon: 1;
                label: "深色";
                selected: Theme.mode == 1;
                picked => {
                    Theme.mode = 1;
                    root.menu-open = false;
                }
            }
            ThemeOption {
                icon: 2;
                label: "跟随系统";
                selected: Theme.mode == 2;
                picked => {
                    Theme.mode = 2;
                    root.menu-open = false;
                }
            }
        }
    }
}
