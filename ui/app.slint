// oWakaka P0 对话壳装配层：AppWindow 无边框窗口（no-frame）+ 自绘标题栏（右上角三键），
// 其下三框布局——左会话栏（session.slint，可拖宽）| 右上对话区（bubble.slint 气泡）
// | 右下输入区（input.slint，可拖高）。拖拽条见 splitter.slint；
// ChatMessage/SessionItem 在此统一再导出供 Rust 消费。
// 配色一律取自 theme.slint 的 Theme 全局（VS Code 现代深/浅双主题 + 跟随系统）。

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { VSplitter, HSplitter } from "splitter.slint";
import { ChatMessage, Bubble } from "bubble.slint";
import { SessionSidebar, SessionItem } from "session.slint";
import { InputArea, ModelItem } from "input.slint";
import { SettingsPage, ProvRow, ModelRow, RemoteRow, AstRow } from "settings.slint";

// 再导出供 Rust（include_modules）消费的 struct
export { ChatMessage, SessionItem, ModelItem, ProvRow, ModelRow, RemoteRow, AstRow }

/// 回收站一行（逻辑删除的会话）
export struct TrashItem {
    id: int,
    title: string,
}

/// 回收站浮层里的小文字按钮
component TinyBtn inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback picked();

    width: t.preferred-width + 14px;
    height: 22px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.p.inputBorder;
    background: ta.has-hover ? Theme.p.listHover : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    t := Text {
        x: 7px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.danger ? #e57373 : Theme.p.link;
        font-size: 12px;
    }
}

// —— 无边框自绘标题栏：原生窗口按钮桥（min/max/close/drag）与 CaptionBar 组件 ——
// 图标一律图元自绘：Unicode ✕/❐ 在默认字体下缺字成豆腐块「口」、且大小不一

/// 标题栏 caption 按钮图标种类
enum CaptionIcon {
    minimize,
    maximize,
    restore,
    close,
}

/// 标题栏 caption 按钮：约 46px 宽悬停灰底，danger（关闭）悬停红底白图标
component CaptionBtn inherits Rectangle {
    in property <CaptionIcon> icon;
    in property <bool> danger: false;
    callback picked();

    property <brush> fg: ta.has-hover && root.danger ? white : Theme.p.textSecondary;
    // 实底按钮色（非悬停=标题栏底色）：还原图标前块用它遮住后块重叠线
    property <brush> btn-bg: ta.has-hover ? (root.danger ? #c42b1c : Theme.p.listHover) : Theme.p.windowBg;

    width: 46px;
    background: root.btn-bg;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    // 图标统一 16×16 viewbox 描边（同 theme.slint Icon 惯例）
    // 最小化：横条
    Path {
        visible: root.icon == CaptionIcon.minimize;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.fg;
        stroke-width: 1.2px;
        fill: transparent;
        commands: "M3,8 H13";
    }
    // 最大化：方框
    Path {
        visible: root.icon == CaptionIcon.maximize;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.fg;
        stroke-width: 1.2px;
        fill: transparent;
        commands: "M3,3 H13 V13 H3 Z";
    }
    // 还原：后框描边 + 前框实底挡重叠线
    Path {
        visible: root.icon == CaptionIcon.restore;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.fg;
        stroke-width: 1.2px;
        fill: transparent;
        commands: "M2,2 H10 V10 H2 Z";
    }
    Path {
        visible: root.icon == CaptionIcon.restore;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.fg;
        stroke-width: 1.2px;
        fill: root.btn-bg;
        commands: "M6,6 H14 V14 H6 Z";
    }
    // 关闭：斜交叉
    Path {
        visible: root.icon == CaptionIcon.close;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.fg;
        stroke-width: 1.2px;
        fill: transparent;
        commands: "M4,4 L12,12 M12,4 L4,12";
    }
}

/// 顶部 34px 标题栏：拖拽区（按下发起原生拖窗，双击切最大化）+ 右三键
///（Windows 惯例序：最小化/最大化·还原/关闭，关闭贴右角）
component CaptionBar inherits Rectangle {
    in property <bool> is-maximized;
    callback win-minimize();
    callback win-maximize();
    callback win-close();
    callback win-drag();

    background: Theme.p.windowBg;
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            horizontal-stretch: 1;
            TouchArea {
                width: parent.width;
                height: parent.height;
                pointer-event(ev) => {
                    if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                        root.win-drag();
                    }
                }
                double-clicked => { root.win-maximize(); }
            }
            Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: "oWakaka";
                color: Theme.p.textMuted;
                font-size: 12px;
            }
        }
        CaptionBtn {
            icon: CaptionIcon.minimize;
            picked => { root.win-minimize(); }
        }
        CaptionBtn {
            icon: root.is-maximized ? CaptionIcon.restore : CaptionIcon.maximize;
            picked => { root.win-maximize(); }
        }
        CaptionBtn {
            icon: CaptionIcon.close;
            danger: true;
            picked => { root.win-close(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "oWakaka";
    background: Theme.p.windowBg;
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 460px;
    // 无边框：winit 后端 set_decorations(false)；外圈 6px 可拖拽缩放
    no-frame: true;
    resize-border-width: 6px;

    in property <[ChatMessage]> messages;
    in property <bool> generating; // 当前可见会话是否生成中
    in property <bool> thinking-on; // 思考模式开关（作用于之后的发送）
    in property <bool> thinking-capable: true; // 当前激活模型支持思考（Step C：不支持则置灰+发送强制关）
    in property <[SessionItem]> sessions;
    in property <[ModelItem]> models; // 模型下拉：config 别名 ∪ 远端 /models（Rust 合并）
    in property <string> model-label; // 当前激活模型显示名
    // —— 聊天卡头栏：当前会话绑定助手（Rust 切换/新建会话时同步；悬空回落默认助手） ——
    in property <string> chat-ast-name;
    in property <string> chat-ast-initial; // 名称首字（无图头像圆底用）
    in property <color> chat-ast-color;    // 圆底色（按助手 id 哈希）
    in property <image> chat-ast-img;      // 头像图片（空图 width=0 → 画圆底首字）
    in property <bool> settings-page; // 设置整页开关（true = 显示设置页，主三框整体切换）
    // —— 回收站（会话两级删除的找回入口） ——
    in property <bool> trash-open;
    in property <[TrashItem]> trash-list;
    // 主题持久化桥：Rust 经此属性读写（kv "ui"），双向链到 Theme 全局；
    // 侧栏菜单/设置页仍直接改 Theme.mode，即时生效同一条链
    in-out property <int> ui-theme <=> Theme.mode;
    callback theme-changed(int); // ui-theme 变动 → Rust 落库 kv "ui"

    changed ui-theme => { root.theme-changed(root.ui-theme); }
    // —— 提供商页状态（providers 整包视图；Rust 注入/回注，密钥不下 UI） ——
    in property <[ProvRow]> provs;
    in-out property <string> prov-sel;
    in-out property <string> prov-name;
    in-out property <string> prov-base;
    in-out property <string> prov-suffix;
    in-out property <string> prov-key;
    in-out property <int> prov-api;
    in property <string> sel-kind;
    in property <bool> sel-locked;
    in property <bool> sel-active;
    in property <bool> sel-deleted;
    in property <string> prov-status;
    // —— Step B：模型管理（当前提供商模型 + 远端拉取清单） ——
    in property <[ModelRow]> prov-models;
    in property <[RemoteRow]> remote-models;
    in property <bool> remote-loading;
    callback prov-fetch();                 // 拉取远端 /models（用表单当前值）
    callback prov-model-added(string);     // 从远端 ＋ 添加
    callback prov-model-custom(string, string); // 自定义 id + 别名
    callback prov-model-alias(string, string);  // 改别名
    callback prov-model-commit(string); // 别名编辑「完成」→ 回刷列表/下拉
    callback prov-model-cap(string, int, bool); // 改能力位（0思考1视觉2语音3视频4工具）
    callback prov-model-removed(string);   // 移除模型
    callback prov-created(int);
    callback prov-selected(string);
    callback prov-used();
    callback prov-saved();
    callback prov-deleted();
    callback prov-restored();
    callback prov-purged();
    callback prov-tested();
    // —— AI 助手页状态（多助手 CRUD；Rust 注入/回注，「完成」写回） ——
    in property <[AstRow]> asts;
    in-out property <string> ast-sel;
    in-out property <string> ast-name;
    in-out property <string> ast-prompt;
    in-out property <string> ast-temp;
    in-out property <string> ast-opening;
    in-out property <string> ast-model;
    in property <string> ast-avatar;
    in property <image> ast-avatar-img;
    in property <color> ast-avatar-color;
    in property <string> ast-initial;
    in property <bool> sel-ast-default;
    in property <bool> sel-ast-deleted;
    in property <string> ast-status;
    callback ast-created();
    callback ast-selected(string);
    callback ast-saved();
    callback ast-deleted();
    callback ast-restored();
    callback ast-purged();
    callback ast-defaulted();
    callback ast-avatar-picked();
    callback ast-avatar-cleared();
    // persona 初值：Rust 打开设置页时从 DB 读取注入
    in property <string> cfg-user-persona; // 角色设定：用户人设（persona 表）
    in property <string> cfg-status; // 保存结果回显（错误/成功文案）
    callback send(string);
    callback copy(string); // 复制回答正文到系统剪贴板（Rust 侧经 arboard 落地）
    callback new-session();
    callback select-session(int);
    callback session-delete(int); // 侧栏行 ✕ → 逻辑删除
    callback trash-requested();   // 打开回收站浮层
    callback trash-closed();
    callback trash-restore(int);  // 会话 id（rowid < 2^31，i32 足够）
    callback trash-purge(int);
    callback stop(); // 停止当前可见会话的生成
    callback toggle-thinking();
    callback model-picked(string); // 选择模型（Rust 切换激活 + 回写设置 kv）
    callback models-requested(); // 打开下拉时请求刷新远端模型清单（异步 /models）
    callback settings-requested(); // 进入设置整页（Rust 读配置注入初值 + settings-page 置 true）
    callback settings-saved(string); // 用户人设（persona user 页保存；提供商/助手页卡内保存）
    callback settings-back(); // 返回对话（放弃未保存编辑）
    // —— 标题栏窗控桥（Rust ui/frame.rs 实现拖窗/最小化等原生动作） ——
    callback win-minimize();
    callback win-maximize(); // 最大化/还原互换（标题栏按钮与拖拽区双击共用）
    callback win-drag(); // 拖拽区左键按下 → winit drag_window 原生移窗

    // 侧栏初始宽 190px（默认窗口 1120 的 ~17%）；不得引用 root.width，
    // 否则进入 layoutinfo 环。拖动 vsplit 改写 position 后此值即失效
    property <length> side-width: 190px;
    // 标题栏高：内容块统一下移 caption-height，其下可用高即 content-height
    property <length> caption-height: 34px;
    property <length> content-height: root.height - root.caption-height;

    // 主三框与设置页整页互斥切换：if-block 销毁重建，对话模型在 Rust 侧
    // （Host 簿记 + 窗口属性）不受影响，生成中切页事件照常回流
    if !root.settings-page : HorizontalLayout {
        // 多子元素组件里 if-block 不自动撑满：显式铺满内容区（标题栏之下），否则底部露馅（"大下巴"）
        x: 0;
        y: root.caption-height;
        width: root.width;
        height: root.content-height;
        padding: 10px;
        spacing: 0;

        SessionSidebar {
            width: vsplit.position;
            sessions: root.sessions;
            trash-count: root.trash-list.length;
            new-clicked => { root.new-session(); }
            row-clicked(i) => { root.select-session(i); }
            session-delete(i) => { root.session-delete(i); }
            trash-clicked => { root.trash-requested(); }
            settings-clicked => { root.settings-requested(); }
        }
        vsplit := VSplitter {
            position: root.side-width;
            min-pos: 150px;
            max-pos: 420px;
        }

        VerticalLayout {
            spacing: 0;

            // 聊天卡片：吃满剩余高度；顶部助手头栏 44px，其下滚动区四周留白 8px
            Rectangle {
                vertical-stretch: 1;
                background: Theme.p.panelBg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.p.panelBorder;
                clip: true;

                // 当前会话助手：圆形头像（有图盖图，无图色板圆底+首字）+ 名称
                HorizontalLayout {
                    height: 44px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    // 布局不垂直居中定高元素：外套吃满行高的 Rectangle，圆内自居中
                    Rectangle {
                        width: 28px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            clip: true;
                            background: root.chat-ast-color;
                            if root.chat-ast-img.width > 0 : Image {
                                width: 28px;
                                height: 28px;
                                source: root.chat-ast-img;
                                image-fit: cover;
                            }
                            if root.chat-ast-img.width == 0 : Text {
                                width: 28px;
                                height: 28px;
                                text: root.chat-ast-initial;
                                color: white;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: root.chat-ast-name;
                        color: Theme.p.textPrimary;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle {
                    y: 44px;
                    height: 1px;
                    background: Theme.p.panelBorder;
                }

                ScrollView {
                    x: 8px;
                    y: 52px;
                    width: parent.width - 16px;
                    height: parent.height - 60px;
                    // 视口宽钉死为可见宽：否则长消息把视口撑宽，气泡整体偏右、贴不出边距
                    viewport-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    // as-needed 的滚动条仅悬停时显形，深色底上近乎不可见 → 常显
                    vertical-scrollbar-policy: always-on;
                    // 粘底状态机：viewport-y 为负值语义（0=顶部，height-viewport-height=底部）。
                    // scrolled() 仅在用户滚动时触发：滚离底部即脱离粘底，滚回底部自动恢复；
                    // 内容变化时仅当粘底才贴底。
                    property <bool> stick: true;
                    scrolled => {
                        self.stick = self.viewport-y <= self.height - self.viewport-height + 2px;
                    }
                    changed viewport-height => {
                        if (self.stick) {
                            self.viewport-y = self.height - self.viewport-height;
                        }
                    }
                    changed height => {
                        if (self.stick) {
                            self.viewport-y = self.height - self.viewport-height;
                        }
                    }
                    VerticalLayout {
                        for m in root.messages: Bubble {
                            msg: m;
                            // 手动切换即脱离自动态，此后不再被自动收起
                            think-toggled => {
                                m.tstate = Math.mod(m.tstate + 1, 3);
                                m.tauto = false;
                            }
                            copy-request(text) => { root.copy(text); }
                        }
                    }
                }
            }

            hs := HSplitter {
                position: 120px;
                min-pos: 64px;
                max-pos: 260px;
            }
            InputArea {
                height: hs.position;
                generating: root.generating;
                thinking-on: root.thinking-on;
                thinking-capable: root.thinking-capable;
                models: root.models;
                model-label: root.model-label;
                send-submit(text) => { root.send(text); }
                stop-request => { root.stop(); }
                thinking-toggled => { root.toggle-thinking(); }
                model-picked(id) => { root.model-picked(id); }
                models-requested => { root.models-requested(); }
            }
        }
    }

    // —— 回收站浮层：遮罩 + 居中卡（恢复 / 彻底删除）。只盖内容区，标题栏在其上层 ——
    if root.trash-open : Rectangle {
        x: 0;
        y: root.caption-height;
        width: root.width;
        height: root.content-height;
        background: rgba(0, 0, 0, 0.45);
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.trash-closed(); }
        }
    }
    if root.trash-open : Rectangle {
        x: (root.width - self.width) / 2;
        y: root.caption-height + (root.content-height - self.height) / 2;
        width: Math.min(400px, root.width - 60px);
        height: Math.min(420px, root.content-height - 40px);
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.p.panelBorder;
        background: Theme.p.panelBg;
        clip: true;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            HorizontalLayout {
                height: 24px;
                spacing: 8px;
                Text {
                    text: "回收站";
                    color: Theme.p.textPrimary;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                TinyBtn {
                    label: "关闭";
                    picked => { root.trash-closed(); }
                }
            }
            if root.trash-list.length == 0 : Text {
                text: "没有已删除的会话。侧栏条目悬停后点行右侧的叉号，删掉的会话会先进这里。";
                color: Theme.p.textMuted;
                font-size: 12px;
                wrap: word-wrap;
            }
            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: 4px;
                    for t in root.trash-list : HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        Text {
                            text: t.title;
                            horizontal-stretch: 1;
                            color: Theme.p.textSecondary;
                            font-size: 13px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        TinyBtn {
                            label: "恢复";
                            picked => { root.trash-restore(t.id); }
                        }
                        TinyBtn {
                            label: "彻底删除";
                            danger: true;
                            picked => { root.trash-purge(t.id); }
                        }
                    }
                }
            }
            Text {
                text: "恢复 = 放回侧栏末尾；彻底删除连同全部消息物理清除，不可找回。";
                color: Theme.p.textMuted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }

    // —— 设置整页：与主三框互斥切换，进入即重建；提供商页双向链到本窗口属性 ——
    if root.settings-page : SettingsPage {
        x: 0;
        y: root.caption-height;
        width: root.width;
        height: root.content-height;
        provs: root.provs;
        prov-sel <=> root.prov-sel;
        prov-name <=> root.prov-name;
        prov-base <=> root.prov-base;
        prov-suffix <=> root.prov-suffix;
        prov-key <=> root.prov-key;
        prov-api <=> root.prov-api;
        sel-kind: root.sel-kind;
        sel-locked: root.sel-locked;
        sel-active: root.sel-active;
        sel-deleted: root.sel-deleted;
        prov-status: root.prov-status;
        prov-models: root.prov-models;
        remote-models: root.remote-models;
        remote-loading: root.remote-loading;
        prov-fetch => { root.prov-fetch(); }
        prov-model-added(id) => { root.prov-model-added(id); }
        prov-model-custom(id, alias) => { root.prov-model-custom(id, alias); }
        prov-model-alias(id, alias) => { root.prov-model-alias(id, alias); }
        prov-model-commit(id) => { root.prov-model-commit(id); }
        prov-model-cap(id, cap, on) => { root.prov-model-cap(id, cap, on); }
        prov-model-removed(id) => { root.prov-model-removed(id); }
        prov-created(k) => { root.prov-created(k); }
        prov-selected(id) => { root.prov-selected(id); }
        prov-used => { root.prov-used(); }
        prov-saved => { root.prov-saved(); }
        prov-deleted => { root.prov-deleted(); }
        prov-restored => { root.prov-restored(); }
        prov-purged => { root.prov-purged(); }
        prov-tested => { root.prov-tested(); }
        asts: root.asts;
        ast-sel <=> root.ast-sel;
        ast-name <=> root.ast-name;
        ast-prompt <=> root.ast-prompt;
        ast-temp <=> root.ast-temp;
        ast-opening <=> root.ast-opening;
        ast-model <=> root.ast-model;
        ast-avatar: root.ast-avatar;
        ast-avatar-img: root.ast-avatar-img;
        ast-avatar-color: root.ast-avatar-color;
        ast-initial: root.ast-initial;
        sel-ast-default: root.sel-ast-default;
        sel-ast-deleted: root.sel-ast-deleted;
        ast-status: root.ast-status;
        ast-models: root.models;
        ast-created => { root.ast-created(); }
        ast-selected(id) => { root.ast-selected(id); }
        ast-saved => { root.ast-saved(); }
        ast-deleted => { root.ast-deleted(); }
        ast-restored => { root.ast-restored(); }
        ast-purged => { root.ast-purged(); }
        ast-defaulted => { root.ast-defaulted(); }
        ast-avatar-picked => { root.ast-avatar-picked(); }
        ast-avatar-cleared => { root.ast-avatar-cleared(); }
        init-user-persona: root.cfg-user-persona;
        status: root.cfg-status;
        saved(persona) => { root.settings-saved(persona); }
        back => { root.settings-back(); }
    }

    // 标题栏 z 序最后绘制：盖在回收站遮罩之上，任何页面都能窗控
    CaptionBar {
        x: 0;
        y: 0;
        width: root.width;
        height: root.caption-height;
        is-maximized: root.maximized;
        win-minimize => { root.win-minimize(); }
        win-maximize => { root.win-maximize(); }
        // 关闭直接走 WindowItem.close()：触发 close-requested，默认销毁窗口退出事件循环
        win-close => { root.close(); }
        win-drag => { root.win-drag(); }
    }
}
