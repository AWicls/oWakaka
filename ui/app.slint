// oWakaka P0 对话壳：3:2 窗口，消息聊天气泡流，底部输入框 + 发送按钮。
// 助手气泡含思考过程三态展示（收起/部分/全开）。
// 当前为硬编码深色配色，浅色/深色自适应后续增量处理。

import { Button, LineEdit, ScrollView } from "std-widgets.slint";

/// 一条聊天消息（气泡数据源）
export struct ChatMessage {
    role: string, // "user" | "assistant"
    text: string, // 回答正文
    thinking: string, // 思考过程全文（仅 assistant；无思考时为空）
    tstate: int, // 思考展示态：0 收起 | 1 部分（最新3行）| 2 全开
    tauto: bool, // 未被手动干预：思考完成时"部分"态自动转收起
}

/// 单条消息：assistant = Thinking 按钮 + 思考面板 + 回答卡 + 复制钮；user = 右对齐回答卡。
/// 回答卡宽度随内容自适应（上限 82%）；思考面板固定占宽 82%，收起时由 ScrollView 原生裁剪，不外泄。
component Bubble inherits Rectangle {
    in property <ChatMessage> msg;
    callback think-toggled();
    callback copy-request(string);

    property <bool> has-thinking: msg.role == "assistant" && msg.thinking != "";
    property <bool> thinking-open: has-thinking && msg.tstate != 0;
    property <bool> has-answer: msg.text != ""; // user 消息恒非空

    // —— 思考切换按钮：附在回答气泡上方左侧，文字统一为 Thinking…… ——
    think-btn := TouchArea {
        visible: root.has-thinking;
        x: 16px;
        y: 4px;
        width: think-lbl.width + 8px;
        height: think-lbl.height + 6px;
        mouse-cursor: pointer;
        clicked => { root.think-toggled(); }
        think-lbl := Text {
            x: 4px;
            y: 3px;
            text: (root.msg.tstate == 0 ? "▸ " : "▾ ") + "Thinking……";
            color: #8f96a3;
            font-size: 13px;
        }
    }

    // —— 思考内容面板：透明灰底 + 灰色虚线框；部分态 3 行高可滚动，全开态完整展示 ——
    think-frame := Rectangle {
        visible: root.thinking-open;
        x: 16px;
        y: think-btn.y + think-btn.height + 4px;
        width: root.width * 0.82;
        height: (root.msg.tstate == 1 ? 54px : think-text.height) + 12px;
        background: #ffffff0a;
        // Slint 1.17 核心无虚线描边能力：半透明实线灰框 + 透明灰底达成"虚灰框"观感
        border-width: 1px;
        border-color: #6b728099;
        border-radius: 8px;
        clip: true;

        ScrollView {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: root.msg.tstate == 1 ? 54px : think-text.height;
            // 粘底状态机（同消息列表）：scrolled 仅用户触发，负值语义
            property <bool> stick: true;
            scrolled => {
                self.stick = self.viewport-y <= self.height - self.viewport-height + 2px;
            }
            changed viewport-height => {
                if (self.stick) {
                    self.viewport-y = self.height - self.viewport-height;
                }
            }
            changed height => {
                if (self.stick) {
                    self.viewport-y = self.height - self.viewport-height;
                }
            }
            think-text := Text {
                width: parent.width - 8px;
                text: root.msg.thinking;
                wrap: word-wrap;
                color: #b8bec8;
                font-size: 13px;
            }
        }
    }

    // —— 回答卡：宽度取正文自然宽（preferred-width），上限 82%，靠向发言侧 ——
    answer := Rectangle {
        property <bool> is-user: root.msg.role == "user";
        visible: root.has-answer;
        width: min(max(msg-text.preferred-width + 24px, 48px), root.width * 0.82);
        x: is-user ? root.width - self.width - 16px : 16px;
        y: thinking-open ? think-frame.y + think-frame.height + 4px
            : has-thinking ? think-btn.y + think-btn.height + 4px
            : 6px;
        border-radius: 14px;
        background: is-user ? #2f6fed : #2c2e35;
        height: msg-text.height + 16px;

        msg-text := Text {
            x: 12px;
            y: 8px;
            width: parent.width - 24px;
            text: root.msg.text;
            wrap: word-wrap;
            color: #f3f4f6;
            horizontal-alignment: answer.is-user ? right : left;
        }
    }

    // —— 复制按钮：回答气泡下方的最右边 ——
    copy-btn := TouchArea {
        visible: answer.visible && root.msg.role == "assistant";
        x: answer.x + answer.width - self.width;
        y: answer.y + answer.height + 2px;
        width: copy-lbl.width + 12px;
        height: copy-lbl.height + 6px;
        mouse-cursor: pointer;
        clicked => { root.copy-request(root.msg.text); }
        copy-lbl := Text {
            x: 6px;
            y: 3px;
            text: "复制";
            color: #8f96a3;
            font-size: 12px;
        }
    }

    height: root.has-answer
        ? answer.y + answer.height + (copy-btn.visible ? copy-btn.height + 4px : 12px)
        : (thinking-open ? think-frame.y + think-frame.height : think-btn.y + think-btn.height) + 12px;
}

export component AppWindow inherits Window {
    title: "oWakaka";
    background: #17181c;
    // 3:2 方框
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 420px;
    min-height: 320px;

    in property <[ChatMessage]> messages;
    in property <bool> busy;
    callback send(string);
    callback copy(string); // 复制回答正文到系统剪贴板（Rust 侧经 arboard 落地）

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        ScrollView {
            // 粘底状态机：viewport-y 为负值语义（0=顶部，height-viewport-height=底部）。
            // scrolled() 仅在用户滚动时触发：滚离底部即脱离粘底，滚回底部自动恢复；
            // 内容变化时仅当粘底才贴底。
            property <bool> stick: true;
            scrolled => {
                self.stick = self.viewport-y <= self.height - self.viewport-height + 2px;
            }
            changed viewport-height => {
                if (self.stick) {
                    self.viewport-y = self.height - self.viewport-height;
                }
            }
            changed height => {
                if (self.stick) {
                    self.viewport-y = self.height - self.viewport-height;
                }
            }
            VerticalLayout {
                for m in root.messages: Bubble {
                    msg: m;
                    // 手动切换即脱离自动态，此后不再被自动收起
                    think-toggled => {
                        m.tstate = Math.mod(m.tstate + 1, 3);
                        m.tauto = false;
                    }
                    copy-request(text) => { root.copy(text); }
                }
            }
        }

        HorizontalLayout {
            input := LineEdit {
                placeholder-text: "输入消息，Enter 发送";
                enabled: !root.busy;
                accepted => {
                    root.send(self.text);
                    self.text = "";
                }
            }
            Button {
                text: root.busy ? "生成中…" : "发送";
                enabled: !root.busy && input.text != "";
                clicked => {
                    root.send(input.text);
                    input.text = "";
                }
            }
        }
    }
}
