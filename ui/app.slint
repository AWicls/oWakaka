// oWakaka P0 对话壳装配层：AppWindow 三框布局——左会话栏（session.slint，可拖宽）
// | 右上对话区（bubble.slint 气泡） | 右下输入区（input.slint，可拖高）。
// 拖拽条见 splitter.slint；ChatMessage/SessionItem 在此统一再导出供 Rust 消费。
// 配色一律取自 theme.slint 的 Theme 全局（VS Code 现代深/浅双主题 + 跟随系统）。

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { VSplitter, HSplitter } from "splitter.slint";
import { ChatMessage, Bubble } from "bubble.slint";
import { SessionSidebar, SessionItem } from "session.slint";
import { InputArea, ModelItem } from "input.slint";

// 再导出供 Rust（include_modules）消费的 struct
export { ChatMessage, SessionItem, ModelItem }

export component AppWindow inherits Window {
    title: "oWakaka";
    background: Theme.p.windowBg;
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 460px;

    in property <[ChatMessage]> messages;
    in property <bool> generating; // 当前可见会话是否生成中
    in property <bool> thinking-on; // 思考模式开关（作用于之后的发送）
    in property <[SessionItem]> sessions;
    in property <[ModelItem]> models; // 模型下拉：config 别名 ∪ 远端 /models（Rust 合并）
    in property <string> model-label; // 当前激活模型显示名
    callback send(string);
    callback copy(string); // 复制回答正文到系统剪贴板（Rust 侧经 arboard 落地）
    callback new-session();
    callback select-session(int);
    callback stop(); // 停止当前可见会话的生成
    callback toggle-thinking();
    callback model-picked(string); // 选择模型（Rust 切换激活 + 回写 config.toml）
    callback models-requested(); // 打开下拉时请求刷新远端模型清单（异步 /models）

    // 侧栏初始宽 190px（默认窗口 1120 的 ~17%）；不得引用 root.width，
    // 否则进入 layoutinfo 环。拖动 vsplit 改写 position 后此值即失效
    property <length> side-width: 190px;

    HorizontalLayout {
        padding: 10px;
        spacing: 0;

        SessionSidebar {
            width: vsplit.position;
            sessions: root.sessions;
            new-clicked => { root.new-session(); }
            row-clicked(i) => { root.select-session(i); }
        }
        vsplit := VSplitter {
            position: root.side-width;
            min-pos: 150px;
            max-pos: 420px;
        }

        VerticalLayout {
            spacing: 0;

            // 聊天卡片：吃满剩余高度；滚动区四周留白 8px
            Rectangle {
                vertical-stretch: 1;
                background: Theme.p.panelBg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.p.panelBorder;
                clip: true;

                ScrollView {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    // 视口宽钉死为可见宽：否则长消息把视口撑宽，气泡整体偏右、贴不出边距
                    viewport-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    // as-needed 的滚动条仅悬停时显形，深色底上近乎不可见 → 常显
                    vertical-scrollbar-policy: always-on;
                    // 粘底状态机：viewport-y 为负值语义（0=顶部，height-viewport-height=底部）。
                    // scrolled() 仅在用户滚动时触发：滚离底部即脱离粘底，滚回底部自动恢复；
                    // 内容变化时仅当粘底才贴底。
                    property <bool> stick: true;
                    scrolled => {
                        self.stick = self.viewport-y <= self.height - self.viewport-height + 2px;
                    }
                    changed viewport-height => {
                        if (self.stick) {
                            self.viewport-y = self.height - self.viewport-height;
                        }
                    }
                    changed height => {
                        if (self.stick) {
                            self.viewport-y = self.height - self.viewport-height;
                        }
                    }
                    VerticalLayout {
                        for m in root.messages: Bubble {
                            msg: m;
                            // 手动切换即脱离自动态，此后不再被自动收起
                            think-toggled => {
                                m.tstate = Math.mod(m.tstate + 1, 3);
                                m.tauto = false;
                            }
                            copy-request(text) => { root.copy(text); }
                        }
                    }
                }
            }

            hs := HSplitter {
                position: 120px;
                min-pos: 64px;
                max-pos: 260px;
            }
            InputArea {
                height: hs.position;
                generating: root.generating;
                thinking-on: root.thinking-on;
                models: root.models;
                model-label: root.model-label;
                send-submit(text) => { root.send(text); }
                stop-request => { root.stop(); }
                thinking-toggled => { root.toggle-thinking(); }
                model-picked(id) => { root.model-picked(id); }
                models-requested => { root.models-requested(); }
            }
        }
    }
}
