// oWakaka P0 对话壳：3:2 窗口，消息聊天气泡流，底部输入框 + 发送按钮。
// 助手气泡含思考过程三态展示（收起/部分/全开）。
// 当前为硬编码深色配色，浅色/深色自适应后续增量处理。

import { Button, LineEdit, ScrollView } from "std-widgets.slint";

/// 一条聊天消息（气泡数据源）
export struct ChatMessage {
    role: string, // "user" | "assistant"
    text: string, // 回答正文
    thinking: string, // 思考过程全文（仅 assistant；无思考时为空）
    tstate: int, // 思考展示态：0 收起 | 1 部分（最新3行）| 2 全开
    tauto: bool, // 未被手动干预：思考完成时"部分"态自动转收起
}

/// 思考过程块：宽度/位置由使用方给出（组件根内不可用 parent），位于回答气泡上方。
/// 点击卡片任意处循环三态；"部分"态只露出最新 3 行。
component ThinkingBlock inherits Rectangle {
    in property <ChatMessage> msg;
    callback toggled();
    property <bool> is-open: msg.tstate != 0;

    visible: msg.thinking != "";
    height: header.height + 12px + (is-open ? body.height : 0px);
    border-radius: 14px;
    background: #232429;
    border-width: 1px;
    border-color: #3a3c44;

    header := Text {
        x: 14px;
        y: 6px;
        width: parent.width - 28px;
        // 流式思考中（还没有回答）显示进行时文案
        text: (msg.tstate == 0 ? "▸ " : "▾ ") + (msg.text == "" && msg.tauto ? "思考中…" : "思考过程");
        color: #9aa0aa;
        font-size: 13px;
    }
    body := Rectangle {
        clip: true;
        x: 14px;
        y: header.y + header.height + 4px;
        width: parent.width - 28px;
        // 部分态固定 3 行高（13px 字号行高约 18px）；全开态完整高度
        height: root.msg.tstate == 1 ? 54px : think-text.height;
        think-text := Text {
            y: min(0px, parent.height - self.height); // 部分态锚底：露出最新内容
            width: parent.width;
            text: root.msg.thinking;
            wrap: word-wrap;
            color: #b8bec8;
            font-size: 13px;
        }
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.toggled(); }
    }
}

/// 单条消息：assistant = 思考块 + 回答卡；user = 仅回答卡，右对齐。
/// 回答卡宽度随内容自适应，上限 82%，靠向各自一侧。
component Bubble inherits Rectangle {
    in property <ChatMessage> msg;
    callback think-toggled();

    height: answer.visible ? answer.y + answer.height + 12px : tb.y + tb.height + 12px;

    // 离屏测量文本（不折行且未约束宽度），其 width 即内容自然宽度
    measure := Text {
        text: root.msg.text;
        opacity: 0;
        x: 0px;
        y: -10000px;
    }

    tb := ThinkingBlock {
        x: 16px;
        y: 6px;
        // 思考块不受回答内容宽度限制，固定占 82%
        width: root.width * 0.82;
        msg: root.msg;
        toggled => { root.think-toggled(); }
    }

    answer := Rectangle {
        property <bool> is-user: root.msg.role == "user";
        // 助手尚未产出回答正文时隐藏（思考流式阶段不留空气泡）
        visible: is-user || root.msg.text != "";
        // 宽度随内容自然宽自适应，上限 82%（measure 为离屏不折行文本）
        width: min(max(measure.width + 28px, 64px), root.width * 0.82);
        x: is-user ? root.width - self.width - 16px : 16px;
        y: tb.visible && !is-user ? tb.y + tb.height + 4px : 6px;
        border-radius: 14px;
        background: is-user ? #2f6fed : #2c2e35;
        height: msg-text.height + 16px;

        msg-text := Text {
            x: 14px;
            y: 8px;
            width: parent.width - 28px;
            text: root.msg.text;
            wrap: word-wrap;
            color: #f3f4f6;
            horizontal-alignment: answer.is-user ? right : left;
        }
    }
}

export component AppWindow inherits Window {
    title: "oWakaka";
    background: #17181c;
    // 3:2 方框
    preferred-width: 960px;
    preferred-height: 640px;
    min-width: 420px;
    min-height: 320px;

    in property <[ChatMessage]> messages;
    in property <bool> busy;
    callback send(string);

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        ScrollView {
            // 粘底滚动：视口始终贴内容底部，新消息/流式增量自动可见。
            // （代价：流式期间手动上滑会被拉回，P0 可接受）
            viewport-y: self.viewport-height - self.height;
            VerticalLayout {
                for m in root.messages: Bubble {
                    msg: m;
                    // 手动切换即脱离自动态，此后不再被自动收起
                    think-toggled => {
                        m.tstate = Math.mod(m.tstate + 1, 3);
                        m.tauto = false;
                    }
                }
            }
        }

        HorizontalLayout {
            input := LineEdit {
                placeholder-text: "输入消息，Enter 发送";
                enabled: !root.busy;
                accepted => {
                    root.send(self.text);
                    self.text = "";
                }
            }
            Button {
                text: root.busy ? "生成中…" : "发送";
                enabled: !root.busy && input.text != "";
                clicked => {
                    root.send(input.text);
                    input.text = "";
                }
            }
        }
    }
}
