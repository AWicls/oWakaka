// oWakaka P0 对话壳装配层：AppWindow 三框布局——左会话栏（session.slint，可拖宽）
// | 右上对话区（bubble.slint 气泡） | 右下输入区（input.slint，可拖高）。
// 拖拽条见 splitter.slint；ChatMessage/SessionItem 在此统一再导出供 Rust 消费。
// 配色一律取自 theme.slint 的 Theme 全局（VS Code 现代深/浅双主题 + 跟随系统）。

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { VSplitter, HSplitter } from "splitter.slint";
import { ChatMessage, Bubble } from "bubble.slint";
import { SessionSidebar, SessionItem } from "session.slint";
import { InputArea, ModelItem } from "input.slint";
import { SettingsPage, ProvRow, ModelRow, RemoteRow } from "settings.slint";

// 再导出供 Rust（include_modules）消费的 struct
export { ChatMessage, SessionItem, ModelItem, ProvRow, ModelRow, RemoteRow }

export component AppWindow inherits Window {
    title: "oWakaka";
    background: Theme.p.windowBg;
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 460px;

    in property <[ChatMessage]> messages;
    in property <bool> generating; // 当前可见会话是否生成中
    in property <bool> thinking-on; // 思考模式开关（作用于之后的发送）
    in property <[SessionItem]> sessions;
    in property <[ModelItem]> models; // 模型下拉：config 别名 ∪ 远端 /models（Rust 合并）
    in property <string> model-label; // 当前激活模型显示名
    in property <bool> settings-page; // 设置整页开关（true = 显示设置页，主三框整体切换）
    // —— 提供商页状态（providers 整包视图；Rust 注入/回注，密钥不下 UI） ——
    in property <[ProvRow]> provs;
    in-out property <string> prov-sel;
    in-out property <string> prov-name;
    in-out property <string> prov-base;
    in-out property <string> prov-suffix;
    in-out property <string> prov-key;
    in-out property <int> prov-api;
    in property <string> sel-kind;
    in property <bool> sel-locked;
    in property <bool> sel-active;
    in property <bool> sel-deleted;
    in property <string> prov-status;
    // —— Step B：模型管理（当前提供商模型 + 远端拉取清单） ——
    in property <[ModelRow]> prov-models;
    in property <[RemoteRow]> remote-models;
    in property <bool> remote-loading;
    callback prov-fetch();                 // 拉取远端 /models（用表单当前值）
    callback prov-model-added(string);     // 从远端 ＋ 添加
    callback prov-model-custom(string, string); // 自定义 id + 别名
    callback prov-model-alias(string, string);  // 改别名
    callback prov-model-cap(string, int, bool); // 改能力位（0思考1视觉2语音3视频4工具）
    callback prov-model-removed(string);   // 移除模型
    callback prov-created(int);
    callback prov-selected(string);
    callback prov-used();
    callback prov-saved();
    callback prov-deleted();
    callback prov-restored();
    callback prov-purged();
    callback prov-tested();
    // persona 初值：Rust 打开设置页时从 DB 读取注入
    in property <string> cfg-system-prompt; // 角色设定：助手 system prompt（persona 表）
    in property <string> cfg-user-persona; // 角色设定：用户人设（persona 表）
    in property <string> cfg-temperature; // 角色设定：温度（空串 = 未设定）
    in property <string> cfg-status; // 保存结果回显（错误/成功文案）
    callback send(string);
    callback copy(string); // 复制回答正文到系统剪贴板（Rust 侧经 arboard 落地）
    callback new-session();
    callback select-session(int);
    callback stop(); // 停止当前可见会话的生成
    callback toggle-thinking();
    callback model-picked(string); // 选择模型（Rust 切换激活 + 回写设置 kv）
    callback models-requested(); // 打开下拉时请求刷新远端模型清单（异步 /models）
    callback settings-requested(); // 进入设置整页（Rust 读配置注入初值 + settings-page 置 true）
    callback settings-saved(string, string, string); // 助手提示词/用户人设/温度（persona 两页保存；提供商页即时落盘）
    callback settings-back(); // 返回对话（放弃未保存编辑）

    // 侧栏初始宽 190px（默认窗口 1120 的 ~17%）；不得引用 root.width，
    // 否则进入 layoutinfo 环。拖动 vsplit 改写 position 后此值即失效
    property <length> side-width: 190px;

    // 主三框与设置页整页互斥切换：if-block 销毁重建，对话模型在 Rust 侧
    // （Host 簿记 + 窗口属性）不受影响，生成中切页事件照常回流
    if !root.settings-page : HorizontalLayout {
        padding: 10px;
        spacing: 0;

        SessionSidebar {
            width: vsplit.position;
            sessions: root.sessions;
            new-clicked => { root.new-session(); }
            row-clicked(i) => { root.select-session(i); }
            settings-clicked => { root.settings-requested(); }
        }
        vsplit := VSplitter {
            position: root.side-width;
            min-pos: 150px;
            max-pos: 420px;
        }

        VerticalLayout {
            spacing: 0;

            // 聊天卡片：吃满剩余高度；滚动区四周留白 8px
            Rectangle {
                vertical-stretch: 1;
                background: Theme.p.panelBg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.p.panelBorder;
                clip: true;

                ScrollView {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    // 视口宽钉死为可见宽：否则长消息把视口撑宽，气泡整体偏右、贴不出边距
                    viewport-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    // as-needed 的滚动条仅悬停时显形，深色底上近乎不可见 → 常显
                    vertical-scrollbar-policy: always-on;
                    // 粘底状态机：viewport-y 为负值语义（0=顶部，height-viewport-height=底部）。
                    // scrolled() 仅在用户滚动时触发：滚离底部即脱离粘底，滚回底部自动恢复；
                    // 内容变化时仅当粘底才贴底。
                    property <bool> stick: true;
                    scrolled => {
                        self.stick = self.viewport-y <= self.height - self.viewport-height + 2px;
                    }
                    changed viewport-height => {
                        if (self.stick) {
                            self.viewport-y = self.height - self.viewport-height;
                        }
                    }
                    changed height => {
                        if (self.stick) {
                            self.viewport-y = self.height - self.viewport-height;
                        }
                    }
                    VerticalLayout {
                        for m in root.messages: Bubble {
                            msg: m;
                            // 手动切换即脱离自动态，此后不再被自动收起
                            think-toggled => {
                                m.tstate = Math.mod(m.tstate + 1, 3);
                                m.tauto = false;
                            }
                            copy-request(text) => { root.copy(text); }
                        }
                    }
                }
            }

            hs := HSplitter {
                position: 120px;
                min-pos: 64px;
                max-pos: 260px;
            }
            InputArea {
                height: hs.position;
                generating: root.generating;
                thinking-on: root.thinking-on;
                models: root.models;
                model-label: root.model-label;
                send-submit(text) => { root.send(text); }
                stop-request => { root.stop(); }
                thinking-toggled => { root.toggle-thinking(); }
                model-picked(id) => { root.model-picked(id); }
                models-requested => { root.models-requested(); }
            }
        }
    }

    // —— 设置整页：与主三框互斥切换，进入即重建；提供商页双向链到本窗口属性 ——
    if root.settings-page : SettingsPage {
        provs: root.provs;
        prov-sel <=> root.prov-sel;
        prov-name <=> root.prov-name;
        prov-base <=> root.prov-base;
        prov-suffix <=> root.prov-suffix;
        prov-key <=> root.prov-key;
        prov-api <=> root.prov-api;
        sel-kind: root.sel-kind;
        sel-locked: root.sel-locked;
        sel-active: root.sel-active;
        sel-deleted: root.sel-deleted;
        prov-status: root.prov-status;
        prov-models: root.prov-models;
        remote-models: root.remote-models;
        remote-loading: root.remote-loading;
        prov-fetch => { root.prov-fetch(); }
        prov-model-added(id) => { root.prov-model-added(id); }
        prov-model-custom(id, alias) => { root.prov-model-custom(id, alias); }
        prov-model-alias(id, alias) => { root.prov-model-alias(id, alias); }
        prov-model-cap(id, cap, on) => { root.prov-model-cap(id, cap, on); }
        prov-model-removed(id) => { root.prov-model-removed(id); }
        prov-created(k) => { root.prov-created(k); }
        prov-selected(id) => { root.prov-selected(id); }
        prov-used => { root.prov-used(); }
        prov-saved => { root.prov-saved(); }
        prov-deleted => { root.prov-deleted(); }
        prov-restored => { root.prov-restored(); }
        prov-purged => { root.prov-purged(); }
        prov-tested => { root.prov-tested(); }
        init-system-prompt: root.cfg-system-prompt;
        init-user-persona: root.cfg-user-persona;
        init-temperature: root.cfg-temperature;
        status: root.cfg-status;
        saved(sys, persona, temp) => { root.settings-saved(sys, persona, temp); }
        back => { root.settings-back(); }
    }
}
