// 输入区卡片：无框自绘编辑器（ScrollView + TextInput）+ 模型切换/Thinking/发送停止按钮行。

import { ScrollView } from "std-widgets.slint";
import { Theme, Icon } from "theme.slint";

/// 模型切换下拉的一行数据源：模型 ID + 显示名（别名或原 ID）+ 是否当前激活
export struct ModelItem {
    id: string,
    display: string,
    current: bool,
}

/// 模型弹层的一行：显示名 + 当前项对勾（同会话栏主题菜单行的观感）
component ModelOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();

    height: 30px;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Rectangle {
        x: 3px;
        y: 2px;
        width: parent.width - 6px;
        height: parent.height - 4px;
        border-radius: 7px;
        background: ta.has-hover ? Theme.p.listHover : transparent;
        Text {
            x: 10px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 44px;
            text: root.label;
            color: Theme.p.textPrimary;
            font-size: 13px;
            overflow: elide;
        }
        Icon {
            visible: root.selected;
            width: 14px;
            height: 14px;
            x: parent.width - self.width - 12px;
            y: (parent.height - self.height) / 2;
            which: 3; // 对勾
            ink: Theme.p.link;
        }
    }
}

/// 输入区卡片：总高由外层拖拽条（HSplitter.position）控制。
/// 编辑器为自绘无框区（std ScrollView + 原生 TextInput）：fluent 内置 TextEdit 的
/// 白底+边框写死在样式内部不可覆盖（widgets/fluent/textedit.slint 实证），故绕开。
/// 编辑区与按钮行之间只隔一段透明间距，不再有任何边框线。
export component InputArea inherits Rectangle {
    in property <bool> generating; // 当前会话是否正在生成（决定发送键=停止键）
    in property <bool> thinking-on;
    in property <[ModelItem]> models; // 模型下拉数据源（Rust 侧合并 config 别名 ∪ 远端 /models）
    in property <string> model-label; // 模型按钮文案（当前激活模型显示名）
    callback send-submit(string);
    callback stop-request();
    callback thinking-toggled();
    callback model-picked(string); // 选择模型（Rust 侧切换 + 回写 config）
    callback models-requested(); // 打开下拉时请求刷新远端模型清单

    background: Theme.p.panelBg;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.p.panelBorder;

    property <bool> model-menu-open: false;

    ed-area := ScrollView {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        // 10 上 + 编辑区 + 12 透明分隔 + 28 按钮行 + 10 下；下限防塌陷
        height: Math.max(24px, root.height - 10px - 12px - 28px - 10px);
        viewport-width: self.visible-width;
        viewport-height: Math.max(self.visible-height, ti.preferred-height);

        // 裸编辑面：零装饰，背景即卡片色；光标跟随滚动逻辑与官方 TextEditBase 同款
        ti := TextInput {
            single-line: false;
            wrap: word-wrap;
            font-size: 14px;
            color: Theme.p.textPrimary;
            selection-background-color: Theme.p.accentSoftBg;
            page-height: ed-area.visible-height;
            // 先于内置编辑处理按键：Ctrl+Enter 发送并吞掉；普通 Enter 放行 → 换行。
            // 生成中/空文本也吞掉组合键，避免插入多余换行
            key-pressed(ev) => {
                if (ev.text == "\n" && ev.modifiers.control) {
                    if (!root.generating && self.text != "") {
                        root.send-submit(self.text);
                        self.text = "";
                    }
                    accept;
                } else {
                    reject;
                }
            }
            cursor-position-changed(cpos) => {
                if (cpos.y + ed-area.viewport-y < 0px) {
                    ed-area.viewport-y = Math.min(0px,
                        Math.max(ed-area.visible-height - self.height, -cpos.y));
                } else if (cpos.y + ed-area.viewport-y > ed-area.visible-height - 20px) {
                    ed-area.viewport-y = Math.min(0px,
                        Math.max(ed-area.visible-height - self.height,
                            ed-area.visible-height - cpos.y - 20px));
                }
            }
        }
    }

    Rectangle {
        x: ed-area.x;
        y: ed-area.y;
        width: ed-area.width;
        height: 20px;
        Text {
            text: ti.text == "" ? "输入消息，Ctrl+Enter 发送（Enter 换行）" : "";
            color: Theme.p.textMuted;
            font-size: 14px;
            vertical-alignment: top;
        }
    }

    btn-row := HorizontalLayout {
        x: 12px;
        y: root.height - 28px - 10px;
        width: parent.width - 24px;
        // 显式高度：游离 layout 默认高度=parent.height，会构成绑定环
        height: 28px;
        spacing: 8px;

        // 模型切换按钮（左下角第一位）：显示当前激活模型，点击向上弹出清单
        model-btn := Rectangle {
            width: Math.max(96px, Math.min(220px, md-lbl.preferred-width + 40px));
            height: 28px;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.model-menu-open ? Theme.p.accentSoftBorder : Theme.p.inputBorder;
            background: mdt.has-hover ? Theme.p.listHover : transparent;
            mdt := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => {
                    root.model-menu-open = !root.model-menu-open;
                    if (root.model-menu-open) {
                        root.models-requested();
                    }
                }
            }
            md-lbl := Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 26px;
                text: root.model-label;
                color: Theme.p.textSecondary;
                font-size: 13px;
                overflow: elide;
            }
            // 下拉小箭头
            Icon {
                x: parent.width - self.width - 8px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                which: 4;
                ink: Theme.p.textMuted;
            }
        }

        // Thinking 开关：默认开；开启态蓝色强调
        Rectangle {
            width: th-lbl.preferred-width + 20px;
            height: 28px;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.thinking-on ? Theme.p.accentSoftBorder : Theme.p.inputBorder;
            background: root.thinking-on ? Theme.p.accentSoftBg
                : (th-ta.has-hover ? Theme.p.listHover : transparent);
            th-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.thinking-toggled(); }
            }
            th-lbl := Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                text: root.thinking-on ? "● Thinking" : "○ Thinking";
                color: root.thinking-on ? Theme.p.link : Theme.p.textSecondary;
                font-size: 13px;
            }
        }
        // 弹性占位，发送/停止按钮贴右下
        Rectangle { }
        // 自绘主按钮（fluent Button 无法随应用主题变色）：VS Code button 语义
        send-btn := Rectangle {
            width: 132px;
            height: 28px;
            border-radius: 8px;
            property <bool> can: root.generating || ti.text != "";
            background: !can ? Theme.p.disabledBg
                : (sb.has-hover && can ? Theme.p.accentHover : Theme.p.accent);
            sb := TouchArea {
                width: parent.width;
                height: parent.height;
                enabled: send-btn.can;
                mouse-cursor: pointer;
                clicked => {
                    if (root.generating) {
                        root.stop-request();
                    } else {
                        root.send-submit(ti.text);
                        ti.text = "";
                    }
                }
            }
            Text {
                width: parent.width;
                y: (parent.height - self.height) / 2;
                text: root.generating ? "■ 停止" : "发送 (Ctrl+Enter)";
                color: send-btn.can ? white : Theme.p.textMuted;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }
    }

    // —— 模型菜单遮罩：点击弹层外区域关闭（覆盖整卡，位于弹层下方）——
    Rectangle {
        visible: root.model-menu-open;
        width: parent.width;
        height: parent.height;
        TouchArea {
            clicked => {
                root.model-menu-open = false;
            }
        }
    }

    // —— 模型清单弹层：向上弹出，锚定模型按钮上方；超 8 项内部滚动 ——
    Rectangle {
        visible: root.model-menu-open;
        x: 12px;
        y: btn-row.y - self.height - 6px;
        width: 240px;
        height: Math.min(root.models.length * 30px + 12px, 8 * 30px + 12px);
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.p.inputBorder;
        background: Theme.p.panelBg;
        clip: true;

        ScrollView {
            width: parent.width;
            height: parent.height;
            viewport-width: self.visible-width;
            vertical-scrollbar-policy: always-on;
            VerticalLayout {
                padding: 6px;
                spacing: 0;
                for m in root.models: ModelOption {
                    label: m.display;
                    selected: m.current;
                    picked => {
                        root.model-picked(m.id);
                        root.model-menu-open = false;
                    }
                }
            }
        }
    }
}
