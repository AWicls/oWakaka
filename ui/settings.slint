// 程序内设置弹窗：左导航（界面/提供商/AI 助手/用户设定）+ 右内容分页。
// 数据源：DB 设置 kv + persona 活跃行 + Theme 全局（界面页直改，即时生效）。
// 由 AppWindow 的 if-block 挂载——每次打开重建实例，表单初值即最新落盘配置。

import { TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

/// 标签 + 单行输入框（空值时显示灰色提示）
component FieldRow inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> hint;

    height: 52px;
    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.p.textMuted;
            font-size: 12px;
        }
        Rectangle {
            height: 30px;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.p.inputBorder;
            background: Theme.p.windowBg;
            ti := TextInput {
                x: 8px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 16px;
                font-size: 13px;
                single-line: true;
                color: Theme.p.textPrimary;
                selection-background-color: Theme.p.accentSoftBg;
                text <=> root.text;
            }
            Text {
                visible: root.hint != "" && ti.text == "";
                x: 8px;
                y: (parent.height - self.height) / 2;
                text: root.hint;
                color: Theme.p.textMuted;
                font-size: 13px;
            }
        }
    }
}

/// 胶囊选项按钮（提供商二选一 / 底部保存取消）
component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> primary: false;
    callback picked();

    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected || root.primary
            ? Theme.p.accentSoftBorder : Theme.p.inputBorder;
    background: root.primary ? Theme.p.accent
            : (root.selected ? Theme.p.accentSoftBg
            : (ta.has-hover ? Theme.p.listHover : transparent));
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Text {
        width: parent.width;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.primary ? white : Theme.p.textPrimary;
        font-size: 13px;
        horizontal-alignment: center;
    }
}

/// 标签 + 多行输入（角色提示词）：std TextEdit 定高内滚（其 viewport-height 与
/// height 内置互绑，外部读取成环，故不自适应高度）。1.17 TextEdit 不露出 color
/// （随 FluentPalette 系统色板，见「已知边界」），提示走 placeholder-text
component PromptRow inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> hint;

    height: 124px;
    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.p.textMuted;
            font-size: 12px;
            wrap: word-wrap;
        }
        Rectangle {
            height: 96px;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.p.inputBorder;
            background: transparent; // 底色由 TextEdit 自绘，套 theme 色会双层
            TextEdit {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                font-size: 13px;
                wrap: word-wrap;
                placeholder-text: root.hint;
                text <=> root.text;
            }
        }
    }
}

/// 左侧分类导航条目（列表式：选中高亮 + 左侧强调条）
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();

    height: 34px;
    border-radius: 7px;
    background: root.selected ? Theme.p.listActive
            : (ta.has-hover ? Theme.p.listHover : transparent);
    Rectangle {
        visible: root.selected;
        x: 0;
        width: 3px;
        y: (parent.height - self.height) / 2;
        height: 18px;
        border-radius: 2px;
        background: Theme.p.accent;
    }
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.selected ? Theme.p.textPrimary : Theme.p.textSecondary;
        font-size: 13px;
    }
}

/// 设置表单卡片：初值由 AppWindow 注入（打开时从 DB 设置 + persona 读取），
/// 保存经回调交给 Rust 侧校验落盘，状态行回显成功/失败文案。
/// 左导航四分区：界面 | 提供商 | AI 助手 | 用户设定——各页是 if-block 实例，
/// 切页即销毁重建，故所有编辑值存于 dialog 级 ed-* property（页面经 <=> 双向绑定）
export component SettingsDialog inherits Rectangle {
    in property <int> init-provider; // 0 通用兼容 | 1 小米 MiMo（与 Rust 映射一致）
    in property <string> init-base-url;
    in property <string> init-api-key;
    in property <string> init-model;
    in property <string> init-system-prompt; // 助手设定（persona assistant）
    in property <string> init-user-persona; // 用户人设（persona user）
    in property <string> init-temperature; // 温度（空 = 未设定）
    in property <string> status;
    callback saved(int, string, string, string, string, string, string);
    callback closed();

    // 0 界面 | 1 提供商（默认：改配置主路径）| 2 AI 助手 | 3 用户设定
    property <int> page: 1;

    // 编辑态（跨页存续）：初值 = 注入的落盘配置
    property <int> ed-provider: root.init-provider;
    in-out property <string> ed-url: root.init-base-url;
    in-out property <string> ed-key: root.init-api-key;
    in-out property <string> ed-model: root.init-model;
    in-out property <string> ed-system: root.init-system-prompt;
    in-out property <string> ed-persona: root.init-user-persona;
    in-out property <string> ed-temp: root.init-temperature;

    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.p.panelBorder;
    background: Theme.p.panelBg;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            // —— 左：分类导航 ——
            VerticalLayout {
                width: 104px;
                spacing: 4px;
                NavItem {
                    label: "界面";
                    selected: root.page == 0;
                    picked => { root.page = 0; }
                }
                NavItem {
                    label: "提供商";
                    selected: root.page == 1;
                    picked => { root.page = 1; }
                }
                NavItem {
                    label: "AI 助手";
                    selected: root.page == 2;
                    picked => { root.page = 2; }
                }
                NavItem {
                    label: "用户设定";
                    selected: root.page == 3;
                    picked => { root.page = 3; }
                }
                Rectangle { vertical-stretch: 1; }
            }

            Rectangle {
                width: 1px;
                background: Theme.p.panelBorder;
            }

            // —— 右：当前分区内容 ——
            VerticalLayout {
                spacing: 10px;

                if root.page == 0 : VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "主题";
                        color: Theme.p.textMuted;
                        font-size: 12px;
                    }
                    Pill {
                        label: "浅色";
                        selected: Theme.mode == 0;
                        picked => { Theme.mode = 0; }
                    }
                    Pill {
                        label: "深色";
                        selected: Theme.mode == 1;
                        picked => { Theme.mode = 1; }
                    }
                    Pill {
                        label: "跟随系统";
                        selected: Theme.mode == 2;
                        picked => { Theme.mode = 2; }
                    }
                    Text {
                        text: "主题即时生效（与侧栏主题菜单同源）；暂不持久，重启回退跟随系统";
                        color: Theme.p.textMuted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.page == 1 : VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "提供商";
                        color: Theme.p.textMuted;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 30px;
                        Rectangle { horizontal-stretch: 1; }
                        Pill {
                            width: 120px;
                            label: "通用兼容";
                            selected: root.ed-provider == 0;
                            picked => { root.ed-provider = 0; }
                        }
                        Pill {
                            width: 120px;
                            label: "小米 MiMo";
                            selected: root.ed-provider == 1;
                            picked => { root.ed-provider = 1; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    FieldRow {
                        label: "API 根地址（custom 必填；MiMo 留空 = 官方端点，写了 = 专属网关覆盖）";
                        text <=> root.ed-url;
                        hint: "https://api.xiaomimimo.com/v1";
                    }
                    FieldRow {
                        label: "API 密钥（留空 = 保持已存值不变）";
                        text <=> root.ed-key;
                        hint: "sk-...";
                    }
                    FieldRow {
                        label: "激活模型（模型下拉与请求携带的 model 字段）";
                        text <=> root.ed-model;
                        hint: "mimo-v2.5";
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.page == 2 : VerticalLayout {
                    spacing: 10px;
                    PromptRow {
                        label: "助手设定（system prompt：每次发送前置注入，留空 = 不发）";
                        text <=> root.ed-system;
                        hint: "例如：你是 oWakaka，回答简洁，中文，代码优先";
                    }
                    FieldRow {
                        label: "温度（0–2；留空 = 不发送该字段，跟随网关默认）";
                        text <=> root.ed-temp;
                        hint: "0.7";
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                if root.page == 3 : VerticalLayout {
                    spacing: 10px;
                    PromptRow {
                        label: "用户人设（并入 system 消息的【用户人设】段，可留空）";
                        text <=> root.ed-persona;
                        hint: "例如：资深 Rust 工程师，关注架构与成本";
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }

        Text {
            visible: root.status != "";
            text: root.status;
            color: Theme.p.link;
            font-size: 12px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            height: 30px;
            Rectangle { horizontal-stretch: 1; }
            Pill {
                width: 72px;
                label: "取消";
                picked => { root.closed(); }
            }
            Pill {
                width: 72px;
                label: "保存";
                primary: true;
                picked => {
                    root.saved(root.ed-provider, root.ed-url, root.ed-key,
                        root.ed-model, root.ed-system, root.ed-persona, root.ed-temp);
                }
            }
        }
    }
}
