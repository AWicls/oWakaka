// 程序内设置整页（与对话界面切换）：左导航（界面/提供商/AI 助手/用户设定）+ 右内容卡片。
// 数据源：DB 设置 kv + persona 活跃行 + Theme 全局（界面页直改，即时生效）。
// 由 AppWindow 的 if-block 挂载——每次打开重建实例，表单初值即最新落盘配置。

import { ScrollView, TextEdit } from "std-widgets.slint";
import { Theme, Icon } from "theme.slint";

/// 标签 + 单行输入框（空值时显示灰色提示）
component FieldRow inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> hint;

    height: 52px;
    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.p.textMuted;
            font-size: 12px;
        }
        Rectangle {
            height: 30px;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.p.inputBorder;
            background: Theme.p.windowBg;
            ti := TextInput {
                x: 8px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 16px;
                font-size: 13px;
                single-line: true;
                color: Theme.p.textPrimary;
                selection-background-color: Theme.p.accentSoftBg;
                text <=> root.text;
            }
            Text {
                visible: root.hint != "" && ti.text == "";
                x: 8px;
                y: (parent.height - self.height) / 2;
                text: root.hint;
                color: Theme.p.textMuted;
                font-size: 13px;
            }
        }
    }
}

/// 胶囊选项按钮（提供商二选一 / 底部保存取消）
component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> primary: false;
    callback picked();

    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected || root.primary
            ? Theme.p.accentSoftBorder : Theme.p.inputBorder;
    background: root.primary ? Theme.p.accent
            : (root.selected ? Theme.p.accentSoftBg
            : (ta.has-hover ? Theme.p.listHover : transparent));
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Text {
        width: parent.width;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.primary ? white : Theme.p.textPrimary;
        font-size: 13px;
        horizontal-alignment: center;
    }
}

/// 标签 + 多行输入（角色提示词）：std TextEdit 定高内滚（其 viewport-height 与
/// height 内置互绑，外部读取成环，故不自适应高度）。1.17 TextEdit 不露出 color
/// （随 FluentPalette 系统色板，见「已知边界」），提示走 placeholder-text
component PromptRow inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> hint;

    height: 124px;
    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.p.textMuted;
            font-size: 12px;
            wrap: word-wrap;
        }
        Rectangle {
            height: 96px;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.p.inputBorder;
            background: transparent; // 底色由 TextEdit 自绘，套 theme 色会双层
            TextEdit {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                font-size: 13px;
                wrap: word-wrap;
                placeholder-text: root.hint;
                text <=> root.text;
            }
        }
    }
}

/// 提供商列表项（列表竖栏）：主行名称、副行状态；编辑中底色、使用中绿点、删除灰显
component ProvItemRow inherits Rectangle {
    in property <string> name;
    in property <string> kind;
    in property <bool> active;
    in property <bool> deleted;
    in property <bool> current;
    callback clicked();

    height: 46px;
    border-radius: 7px;
    background: root.current ? Theme.p.listActive
            : (ta.has-hover ? Theme.p.listHover : transparent);
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding: 8px;
        spacing: 1px;
        Text {
            text: root.name;
            color: root.deleted ? Theme.p.textMuted : Theme.p.textPrimary;
            font-size: 13px;
            overflow: elide;
        }
        Text {
            text: root.deleted ? "已删除" : (root.active ? "● 使用中" : root.kind);
            color: root.active ? Theme.p.link : Theme.p.textMuted;
            font-size: 11px;
            overflow: elide;
        }
    }
}

/// 弹层菜单项（新增提供商类型选择）
component MenuOpt inherits Rectangle {
    in property <string> label;
    callback picked();

    height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.p.listHover : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: Theme.p.textPrimary;
        font-size: 13px;
    }
}

/// 左侧分类导航条目（列表式：选中高亮 + 左侧强调条）
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();

    height: 34px;
    border-radius: 7px;
    background: root.selected ? Theme.p.listActive
            : (ta.has-hover ? Theme.p.listHover : transparent);
    Rectangle {
        visible: root.selected;
        x: 0;
        width: 3px;
        y: (parent.height - self.height) / 2;
        height: 18px;
        border-radius: 2px;
        background: Theme.p.accent;
    }
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.selected ? Theme.p.textPrimary : Theme.p.textSecondary;
        font-size: 13px;
    }
}

/// 返回钮（设置页顶栏）：左箭头图标 + 文字，描边胶囊与整体卡片语汇一致
component BackButton inherits Rectangle {
    callback clicked();

    width: 88px;
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.p.inputBorder;
    background: ta.has-hover ? Theme.p.listHover : Theme.p.panelBg;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 10px;
        spacing: 6px;
        // Rectangle 随布局吃满行高，Icon 定高居中（Slint 布局对固定高元素不垂直居中）
        Rectangle {
            width: 16px;
            Icon {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                which: 6;
                ink: Theme.p.textSecondary;
            }
        }
        Text {
            text: "返回";
            color: Theme.p.textPrimary;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

/// 提供商清单项（列表竖栏数据，Rust 注入）
export struct ProvRow {
    id: string,
    name: string,
    kind: string,       // 厂商标签（展示用）
    active: bool,       // 使用中
    deleted: bool,      // 逻辑删除（灰显）
}

/// 模型管理行：当前提供商已配置的模型（含能力位）
export struct ModelRow {
    id: string,
    alias: string,
    thinking: bool,
    vision: bool,
    audio: bool,
    video: bool,
    tools: bool,
}

/// 远端拉取到的模型（added = 本提供商已收录）
export struct RemoteRow {
    id: string,
    added: bool,
}

/// 能力开关胶囊（点击切换；选中态强调色）
component CapChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();

    height: 22px;
    width: lbl.preferred-width + 16px;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.on ? Theme.p.accentSoftBorder : Theme.p.inputBorder;
    background: root.on ? Theme.p.accentSoftBg : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    lbl := Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.on ? Theme.p.link : Theme.p.textMuted;
        font-size: 11px;
    }
}

/// 模型管理卡中的一行：别名输入 + 能力胶囊 + id 展示 + 移除
component ModelCard inherits Rectangle {
    in property <ModelRow> mdl;
    callback alias-changed(string);
    callback cap(int, bool);
    callback remove-request();

    height: 60px;
    border-radius: 6px;
    background: transparent;
    VerticalLayout {
        padding: 3px;
        spacing: 3px;
        HorizontalLayout {
            height: 24px;
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.p.inputBorder;
                background: Theme.p.windowBg;
                ti := TextInput {
                    x: 6px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 12px;
                    single-line: true;
                    font-size: 12px;
                    color: Theme.p.textPrimary;
                    selection-background-color: Theme.p.accentSoftBg;
                    text: root.mdl.alias;
                    edited => { root.alias-changed(ti.text); }
                }
                Text {
                    visible: ti.text == "";
                    x: 6px;
                    y: (parent.height - self.height) / 2;
                    text: "显示别名（留空 = 原样显示 ID）";
                    color: Theme.p.textMuted;
                    font-size: 12px;
                }
            }
            Pill {
                width: 30px;
                label: "✕";
                picked => { root.remove-request(); }
            }
        }
        HorizontalLayout {
            height: 22px;
            spacing: 4px;
            CapChip {
                label: "思考";
                on: root.mdl.thinking;
                toggled => { root.cap(0, !root.mdl.thinking); }
            }
            CapChip {
                label: "图片";
                on: root.mdl.vision;
                toggled => { root.cap(1, !root.mdl.vision); }
            }
            CapChip {
                label: "语音";
                on: root.mdl.audio;
                toggled => { root.cap(2, !root.mdl.audio); }
            }
            CapChip {
                label: "视频";
                on: root.mdl.video;
                toggled => { root.cap(3, !root.mdl.video); }
            }
            CapChip {
                label: "工具";
                on: root.mdl.tools;
                toggled => { root.cap(4, !root.mdl.tools); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.mdl.id;
                color: Theme.p.textMuted;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}

/// 全屏设置页：顶栏返回 + 左导航四分区。提供商页 = 列表卡 + 详情卡，
/// 字段以 Rust 侧 providers 整包为真相源（in-out 双向链，操作即时回注）；
/// persona 两页存页面级 ed-* 编辑态，底部「保存」一次性提交。
/// 各分区页是 if-block 实例，切页销毁重建。
export component SettingsPage inherits Rectangle {
    // —— 提供商页（Rust 注入/回注；密钥框恒注空，提交空 = 不改已存） ——
    in property <[ProvRow]> provs;
    in-out property <string> prov-sel;      // 正在编辑的条目 id（空 = 无可用）
    in-out property <string> prov-name;
    in-out property <string> prov-base;
    in-out property <string> prov-suffix;
    in-out property <string> prov-key;
    in-out property <int> prov-api;         // 0 chat | 1 responses
    in property <string> sel-kind;          // 当前条目厂商显示名
    in property <bool> sel-locked;          // 定制提供商：接口族锁定
    in property <bool> sel-active;          // 当前条目 = 使用中
    in property <bool> sel-deleted;        // 当前条目已逻辑删除
    in property <string> prov-status;      // 提供商页状态行（测试/保存回显）
    // —— Step B：模型管理 ——
    in property <[ModelRow]> prov-models;
    in property <[RemoteRow]> remote-models;
    in property <bool> remote-loading;
    callback prov-fetch();
    callback prov-model-added(string);
    callback prov-model-custom(string, string);
    callback prov-model-alias(string, string);
    callback prov-model-cap(string, int, bool);
    callback prov-model-removed(string);
    callback prov-created(int);            // 新增菜单选择：0 通用兼容 | 1 小米 MiMo
    callback prov-selected(string);         // 点列表项 → Rust 回注详情
    callback prov-used();                   // 使用此提供商
    callback prov-saved();                  // 完成（表单写回条目 + 密钥）
    callback prov-deleted();                // 逻辑删除
    callback prov-restored();               // 恢复
    callback prov-purged();                 // 彻底删除（连带清密钥）
    callback prov-tested();                 // 测试连通（用表单当前值）

    // —— persona 两页 + 界面页无需回写（主题走 Theme 全局） ——
    in property <string> init-system-prompt; // 助手设定（persona assistant）
    in property <string> init-user-persona; // 用户人设（persona user）
    in property <string> init-temperature; // 温度（空 = 未设定）
    in property <string> status;
    callback saved(string, string, string); // 助手提示词/用户人设/温度
    callback back();

    // 0 界面 | 1 提供商（默认：改配置主路径）| 2 AI 助手 | 3 用户设定
    property <int> page: 1;
    property <bool> add-menu: false;        // 新增提供商弹层
    property <bool> remote-open: false;     // 远端模型清单弹层（拉取按钮开启，遮罩关闭）

    // 编辑态（persona 字段跨页存续）：初值 = 注入的落盘配置
    in-out property <string> ed-system: root.init-system-prompt;
    in-out property <string> ed-persona: root.init-user-persona;
    in-out property <string> ed-temp: root.init-temperature;

    background: Theme.p.windowBg;
    clip: true;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // —— 顶栏：返回 + 页题 ——
        HorizontalLayout {
            height: 34px;
            spacing: 10px;
            BackButton {
                clicked => { root.back(); }
            }
            Text {
                text: "设置";
                color: Theme.p.textPrimary;
                font-size: 16px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            // —— 左：分类导航卡（与对话面板同款圆角描边）——
            Rectangle {
                width: 148px;
                background: Theme.p.panelBg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.p.panelBorder;
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    NavItem {
                        label: "界面";
                        selected: root.page == 0;
                        picked => { root.page = 0; }
                    }
                    NavItem {
                        label: "提供商";
                        selected: root.page == 1;
                        picked => { root.page = 1; }
                    }
                    NavItem {
                        label: "AI 助手";
                        selected: root.page == 2;
                        picked => { root.page = 2; }
                    }
                    NavItem {
                        label: "用户设定";
                        selected: root.page == 3;
                        picked => { root.page = 3; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // —— 提供商页：列表卡 + 详情卡（Rust 为真相源，操作即时回注） ——
            if root.page == 1 : HorizontalLayout {
                spacing: 10px;

                Rectangle {
                    width: 160px;
                    background: Theme.p.panelBg;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.p.panelBorder;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Pill {
                            label: "＋ 新增";
                            picked => { root.add-menu = true; }
                        }
                        for pr in root.provs : ProvItemRow {
                            name: pr.name;
                            kind: pr.kind;
                            active: pr.active;
                            deleted: pr.deleted;
                            current: pr.id == root.prov-sel;
                            clicked => { root.prov-selected(pr.id); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.p.panelBg;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.p.panelBorder;
                    clip: true;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        Text {
                            text: root.prov-sel == "" ? "提供商"
                                : (root.sel-deleted ? "已删除的提供商" : "编辑提供商");
                            color: Theme.p.textPrimary;
                            font-size: 14px;
                        }

                        if root.prov-sel == "" : Text {
                            text: "还没有可用的提供商：点左上「＋ 新增」创建第一个。";
                            color: Theme.p.textMuted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        if root.prov-sel != "" : FieldRow {
                            label: "显示名（留空 = 用厂商标签）";
                            text <=> root.prov-name;
                            hint: root.sel-kind;
                        }
                        if root.prov-sel != "" : FieldRow {
                            label: "基础地址（custom 必填；定制厂商留空 = 内置端点）";
                            text <=> root.prov-base;
                            hint: "https://api.openai.com/v1";
                        }
                        if root.prov-sel != "" : FieldRow {
                            label: "路径后缀（可选，拼在基础地址后）";
                            text <=> root.prov-suffix;
                            hint: "如 proxy/aigw，可留空";
                        }
                        if root.prov-sel != "" : FieldRow {
                            label: "API 密钥（留空 = 保持已存值不变；只存 config.toml，不进 DB）";
                            text <=> root.prov-key;
                            hint: "sk-...";
                        }

                        if root.prov-sel != "" : Text {
                            text: "接入方案";
                            color: Theme.p.textMuted;
                            font-size: 12px;
                        }
                        if root.prov-sel != "" && !root.sel-locked : HorizontalLayout {
                            spacing: 8px;
                            height: 30px;
                            Pill {
                                width: 120px;
                                label: "chat";
                                selected: root.prov-api == 0;
                                picked => { root.prov-api = 0; }
                            }
                            Pill {
                                width: 120px;
                                label: "responses";
                                selected: root.prov-api == 1;
                                picked => { root.prov-api = 1; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.prov-sel != "" && root.sel-locked : Text {
                            text: "responses（定制提供商锁定）";
                            color: Theme.p.textSecondary;
                            font-size: 13px;
                        }

                        // —— Step B：模型管理 ——
                        if root.prov-sel != "" && !root.sel-deleted : VerticalLayout {
                            spacing: 6px;
                            height: 250px;
                            Text {
                                text: "可用模型（拉远端 / 自定义；勾选能力，Step C 起生效）";
                                color: Theme.p.textMuted;
                                font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                height: 26px;
                                custom-id := TextInput {
                                    width: 160px;
                                    height: 26px;
                                    font-size: 12px;
                                    single-line: true;
                                    color: Theme.p.textPrimary;
                                    horizontal-stretch: 1;
                                }
                                custom-alias := TextInput {
                                    width: 110px;
                                    height: 26px;
                                    font-size: 12px;
                                    single-line: true;
                                    color: Theme.p.textPrimary;
                                }
                                Pill {
                                    width: 56px;
                                    label: "自定义+";
                                    picked => {
                                        root.prov-model-custom(custom-id.text, custom-alias.text);
                                        custom-id.text = "";
                                        custom-alias.text = "";
                                    }
                                }
                                Pill {
                                    width: 84px;
                                    label: "拉取远端";
                                    selected: root.remote-loading;
                                    picked => {
                                        root.remote-open = true;
                                        root.prov-fetch();
                                    }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.p.inputBorder;
                                background: Theme.p.windowBg;
                                clip: true;
                                if root.prov-models.length == 0 : Text {
                                    text: "还没有模型，用上方输入或「拉取远端」添加。";
                                    color: Theme.p.textMuted;
                                    font-size: 12px;
                                    x: 8px;
                                    y: 8px;
                                    wrap: word-wrap;
                                    width: parent.width - 16px;
                                }
                                ScrollView {
                                    width: parent.width;
                                    height: parent.height;
                                    viewport-width: self.visible-width;
                                    vertical-scrollbar-policy: always-on;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        for m in root.prov-models : ModelCard {
                                            mdl: m;
                                            alias-changed(a) => { root.prov-model-alias(m.id, a); }
                                            cap(which, on) => { root.prov-model-cap(m.id, which, on); }
                                            remove-request => { root.prov-model-removed(m.id); }
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            visible: root.prov-status != "";
                            text: root.prov-status;
                            color: Theme.p.link;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            spacing: 8px;
                            height: 30px;
                            visible: root.prov-sel != "";
                            Pill {
                                width: 88px;
                                label: "测试连通";
                                picked => { root.prov-tested(); }
                            }
                            Pill {
                                width: 72px;
                                label: "完成";
                                primary: true;
                                picked => { root.prov-saved(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if !root.sel-deleted : Pill {
                                width: 72px;
                                label: "删除";
                                picked => { root.prov-deleted(); }
                            }
                            if !root.sel-deleted && !root.sel-active : Pill {
                                width: 108px;
                                label: "使用此提供商";
                                picked => { root.prov-used(); }
                            }
                            if root.sel-deleted : Pill {
                                width: 72px;
                                label: "恢复";
                                picked => { root.prov-restored(); }
                            }
                            if root.sel-deleted : Pill {
                                width: 88px;
                                label: "彻底删除";
                                picked => { root.prov-purged(); }
                            }
                        }
                    }
                }
            }

            // —— 其余分区：单内容卡 ——
            if root.page != 1 : Rectangle {
                horizontal-stretch: 1;
                background: Theme.p.panelBg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.p.panelBorder;
                clip: true;
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    Text {
                        text: root.page == 0 ? "界面"
                            : root.page == 2 ? "AI 助手设定" : "用户设定";
                        color: Theme.p.textPrimary;
                        font-size: 14px;
                    }

                    if root.page == 0 : VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: "主题";
                            color: Theme.p.textMuted;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            height: 30px;
                            Rectangle { horizontal-stretch: 1; }
                            Pill {
                                width: 110px;
                                label: "浅色";
                                selected: Theme.mode == 0;
                                picked => { Theme.mode = 0; }
                            }
                            Pill {
                                width: 110px;
                                label: "深色";
                                selected: Theme.mode == 1;
                                picked => { Theme.mode = 1; }
                            }
                            Pill {
                                width: 130px;
                                label: "跟随系统";
                                selected: Theme.mode == 2;
                                picked => { Theme.mode = 2; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            text: "主题即时生效（与侧栏主题菜单同源），自动持久化，重启保留";
                            color: Theme.p.textMuted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.page == 2 : VerticalLayout {
                        spacing: 10px;
                        PromptRow {
                            label: "助手设定（system prompt：每次发送前置注入，留空 = 不发）";
                            text <=> root.ed-system;
                            hint: "例如：你是 oWakaka，回答简洁，中文，代码优先";
                        }
                        FieldRow {
                            label: "温度（0–2；留空 = 不发送该字段，跟随网关默认）";
                            text <=> root.ed-temp;
                            hint: "0.7";
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.page == 3 : VerticalLayout {
                        spacing: 10px;
                        PromptRow {
                            label: "用户人设（并入 system 消息的【用户人设】段，可留空）";
                            text <=> root.ed-persona;
                            hint: "例如：资深 Rust 工程师，关注架构与成本";
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        Text {
            visible: root.status != "" && root.page != 1;
            text: root.status;
            color: Theme.p.link;
            font-size: 12px;
            wrap: word-wrap;
        }

        // 全局「保存」只服务 persona 两页；提供商页在详情卡内即时保存
        HorizontalLayout {
            spacing: 8px;
            height: 30px;
            visible: root.page == 2 || root.page == 3;
            Rectangle { horizontal-stretch: 1; }
            Pill {
                width: 88px;
                label: "保存";
                primary: true;
                picked => {
                    root.saved(root.ed-system, root.ed-persona, root.ed-temp);
                }
            }
        }
    }

    // —— 新增提供商：遮罩 + 弹层（锚列表卡「＋ 新增」下方，坐标按固定布局推算） ——
    if root.add-menu : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        TouchArea {
            clicked => { root.add-menu = false; }
        }
    }
    if root.add-menu : Rectangle {
        x: 14px + 148px + 10px + 8px;
        y: 14px + 34px + 12px + 8px + 30px + 4px;
        width: 168px;
        height: 76px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.p.inputBorder;
        background: Theme.p.panelBg;
        VerticalLayout {
            padding: 6px;
            spacing: 0;
            MenuOpt {
                label: "自定义";
                picked => {
                    root.add-menu = false;
                    root.prov-created(0);
                }
            }
            MenuOpt {
                label: "Xiaomi MiMo";
                picked => {
                    root.add-menu = false;
                    root.prov-created(1);
                }
            }
        }
    }

    // —— 远端模型清单弹层：＋收录；已收录 ✓ 灰显（遮罩关闭） ——
    if root.remote-open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        TouchArea {
            clicked => { root.remote-open = false; }
        }
    }
    if root.remote-open : Rectangle {
        x: Math.min(root.width - 340px, 14px + 148px + 10px + 160px + 10px + 24px);
        y: 120px;
        width: 320px;
        height: 400px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.p.inputBorder;
        background: Theme.p.panelBg;
        clip: true;
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            HorizontalLayout {
                height: 24px;
                spacing: 8px;
                Text {
                    text: "远端模型清单";
                    color: Theme.p.textPrimary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Pill {
                    width: 56px;
                    label: "关闭";
                    picked => { root.remote-open = false; }
                }
            }
            if root.remote-loading : Text {
                text: "拉取中…（改地址/密钥后请重开设置再拉）";
                color: Theme.p.textMuted;
                font-size: 12px;
                wrap: word-wrap;
            }
            if !root.remote-loading && root.remote-models.length == 0 : Text {
                text: "暂无清单：点「拉取远端」按当前表单的端点与密钥请求 /models。";
                color: Theme.p.textMuted;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.p.inputBorder;
                background: Theme.p.windowBg;
                clip: true;
                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.visible-width;
                    vertical-scrollbar-policy: always-on;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        for r in root.remote-models : HorizontalLayout {
                            height: 26px;
                            spacing: 6px;
                            Text {
                                text: r.id;
                                horizontal-stretch: 1;
                                color: r.added ? Theme.p.textMuted : Theme.p.textPrimary;
                                font-size: 12px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Pill {
                                width: 44px;
                                label: r.added ? "✓" : "＋";
                                selected: !r.added;
                                picked => {
                                    if !r.added { root.prov-model-added(r.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
