// 程序内设置整页（与对话界面切换）：左导航（界面/提供商/AI 助手/用户设定）+ 右内容卡片。
// 数据源：DB 设置 kv + persona 活跃行 + Theme 全局（界面页直改，即时生效）。
// 由 AppWindow 的 if-block 挂载——每次打开重建实例，表单初值即最新落盘配置。

import { ScrollView, TextEdit } from "std-widgets.slint";
import { Theme, Icon, Card } from "theme.slint";
import { ModelItem } from "input.slint";

/// 标签 + 单行输入框（空值时显示灰色提示）
component FieldRow inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> hint;

    height: 52px;
    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.p.textMuted;
            font-size: 12px;
        }
        Rectangle {
            height: 30px;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.p.inputBorder;
            background: Theme.p.windowBg;
            ti := TextInput {
                x: 8px;
                y: 0;
                width: parent.width - 16px;
                height: parent.height;
                // 官方垂直居中：占满行高后按行盒居中，placeholder 与输入文本同一基准
                vertical-alignment: center;
                single-line: true;
                font-size: 13px;
                color: Theme.p.textPrimary;
                selection-background-color: Theme.p.accentSoftBg;
                text <=> root.text;
            }
            Text {
                visible: root.hint != "" && ti.text == "";
                x: 8px;
                y: (parent.height - self.height) / 2;
                text: root.hint;
                color: Theme.p.textMuted;
                font-size: 13px;
            }
        }
    }
}

/// 胶囊选项按钮（提供商二选一 / 底部保存取消）
component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> primary: false;
    callback picked();

    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected || root.primary
            ? Theme.p.accentSoftBorder : Theme.p.inputBorder;
    background: root.primary ? Theme.p.accent
            : (root.selected ? Theme.p.accentSoftBg
            : (ta.has-hover ? Theme.p.listHover : transparent));
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Text {
        width: parent.width;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.primary ? white : Theme.p.textPrimary;
        font-size: 13px;
        horizontal-alignment: center;
    }
}

/// 标签 + 多行输入（角色提示词）：std TextEdit 定高内滚（其 viewport-height 与
/// height 内置互绑，外部读取成环，故不自适应高度）。1.17 TextEdit 不露出 color
/// （随 FluentPalette 系统色板，见「已知边界」），提示走 placeholder-text
component PromptRow inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> hint;

    height: 124px;
    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.p.textMuted;
            font-size: 12px;
            wrap: word-wrap;
        }
        Rectangle {
            height: 96px;
            border-radius: 7px;
            border-width: 1px;
            border-color: Theme.p.inputBorder;
            background: transparent; // 底色由 TextEdit 自绘，套 theme 色会双层
            TextEdit {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                font-size: 13px;
                wrap: word-wrap;
                placeholder-text: root.hint;
                text <=> root.text;
            }
        }
    }
}

/// 提供商/助手列表项（列表竖栏）：主行名称、副行状态；编辑中底色、使用中强调、删除灰显
component ProvItemRow inherits Rectangle {
    in property <string> name;
    in property <string> kind;
    in property <bool> active;
    in property <string> active-label: "● 使用中"; // active 时副行文案（助手页传「● 默认」）
    in property <bool> deleted;
    in property <bool> current;
    callback clicked();

    height: 46px;
    border-radius: 7px;
    background: root.current ? Theme.p.listActive
            : (ta.has-hover ? Theme.p.listHover : transparent);
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding: 8px;
        spacing: 1px;
        Text {
            text: root.name;
            color: root.deleted ? Theme.p.textMuted : Theme.p.textPrimary;
            font-size: 13px;
            overflow: elide;
        }
        Text {
            text: root.deleted ? "已删除" : (root.active ? root.active-label : root.kind);
            color: root.active ? Theme.p.link : Theme.p.textMuted;
            font-size: 11px;
            overflow: elide;
        }
    }
}

/// 弹层菜单项（新增提供商类型选择）
component MenuOpt inherits Rectangle {
    in property <string> label;
    callback picked();

    height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.p.listHover : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: Theme.p.textPrimary;
        font-size: 13px;
    }
}

/// 左侧分类导航条目（列表式：选中高亮 + 左侧强调条）
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();

    height: 34px;
    border-radius: 7px;
    background: root.selected ? Theme.p.listActive
            : (ta.has-hover ? Theme.p.listHover : transparent);
    Rectangle {
        visible: root.selected;
        x: 0;
        width: 3px;
        y: (parent.height - self.height) / 2;
        height: 18px;
        border-radius: 2px;
        background: Theme.p.accent;
    }
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.selected ? Theme.p.textPrimary : Theme.p.textSecondary;
        font-size: 13px;
    }
}

/// 返回钮（导航卡顶部，与「设置」标题并排）：左箭头 + 文字，可被外层布局定宽
component BackButton inherits Rectangle {
    callback clicked();

    height: 26px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.p.inputBorder;
    background: ta.has-hover ? Theme.p.listHover : Theme.p.panelBg;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 6px;
        spacing: 4px;
        // Rectangle 随布局吃满行高，Icon 定高居中（Slint 布局对固定高元素不垂直居中）
        Rectangle {
            width: 14px;
            Icon {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                which: 6;
                ink: Theme.p.textSecondary;
            }
        }
        Text {
            text: "返回";
            color: Theme.p.textPrimary;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

/// 提供商清单项（列表竖栏数据，Rust 注入）
export struct ProvRow {
    id: string,
    name: string,
    kind: string,       // 厂商标签（展示用）
    active: bool,       // 使用中
    deleted: bool,      // 逻辑删除（灰显）
}

/// 助手清单项（AI 助手页列表竖栏数据，Rust 注入；复用 ProvItemRow 展示）
export struct AstRow {
    id: string,         // persona 行 id 字符串化
    name: string,
    sub: string,        // 副行：默认模型摘要（无则占位文案）
    active: bool,       // 默认助手
    deleted: bool,      // 逻辑删除（灰显）
}

/// 模型管理行：当前提供商已配置的模型（含能力位）
export struct ModelRow {
    id: string,
    alias: string,
    thinking: bool,
    vision: bool,
    audio: bool,
    video: bool,
    tools: bool,
}

/// 远端拉取到的模型（added = 本提供商已收录）
export struct RemoteRow {
    id: string,
    added: bool,
}

/// 能力开关胶囊（点击切换；选中态强调色）
component CapChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();

    height: 22px;
    width: lbl.preferred-width + 16px;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.on ? Theme.p.accentSoftBorder : Theme.p.inputBorder;
    background: root.on ? Theme.p.accentSoftBg : transparent;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    lbl := Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.on ? Theme.p.link : Theme.p.textMuted;
        font-size: 11px;
    }
}

/// 模型管理行：两行常显——名称行（别名优先，请求 ID 灰色后缀，「别名」编辑钮 + 「−」）
/// + 能力行（胶囊直接勾选）。点「别名」仅把名称行切成输入态。
component ModelCard inherits Rectangle {
    in property <ModelRow> mdl;
    in property <bool> editing;
    callback alias-changed(string);
    callback cap(int, bool);
    callback remove-request();
    callback edit-requested();
    callback edit-done();

    height: 58px;
    border-radius: 6px;
    background: transparent;
    VerticalLayout {
        padding: 3px;
        spacing: 2px;
        HorizontalLayout {
            height: 24px;
            spacing: 6px;
            // 别名（有则常显，编辑态也不藏）；if 块收起不占位不吃 spacing（visible 会）
            if root.mdl.alias != "" : Text {
                text: root.mdl.alias;
                color: Theme.p.textPrimary;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
            // 请求 ID：恒显（编辑态也不藏），无别名时升为主色
            Text {
                text: root.mdl.id;
                color: root.mdl.alias != "" ? Theme.p.textMuted : Theme.p.textPrimary;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
            // 编辑态：别名输入框（自带边框，独占剩余宽；visible 门控会与 spacer 平分 stretch）
            if root.editing : Rectangle {
                horizontal-stretch: 1;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.p.inputBorder;
                background: Theme.p.windowBg;
                ti := TextInput {
                    x: 6px;
                    y: 0;
                    width: parent.width - 12px;
                    height: parent.height;
                    vertical-alignment: center;
                    single-line: true;
                    font-size: 12px;
                    color: Theme.p.textPrimary;
                    selection-background-color: Theme.p.accentSoftBg;
                    text: root.mdl.alias;
                    edited => { root.alias-changed(ti.text); }
                }
                Text {
                    visible: ti.text == "";
                    x: 6px;
                    y: 0;
                    height: parent.height;
                    vertical-alignment: center;
                    text: "设置别名（留空显示请求ID）";
                    color: Theme.p.textMuted;
                    font-size: 12px;
                }
            }
            if !root.editing : Rectangle { horizontal-stretch: 1; }
            // 别名 ⇄ 完成：同一按钮原地切换文案/配色
            Pill {
                width: 46px;
                label: root.editing ? "完成" : "别名";
                primary: root.editing;
                picked => {
                    if root.editing {
                        root.edit-done();
                    } else {
                        root.edit-requested();
                    }
                }
            }
            Pill {
                width: 30px;
                label: "−";
                picked => { root.remove-request(); }
            }
        }
        // —— 能力行：常显直切 ——
        HorizontalLayout {
            height: 22px;
            spacing: 4px;
            CapChip {
                label: "思考";
                on: root.mdl.thinking;
                toggled => { root.cap(0, !root.mdl.thinking); }
            }
            CapChip {
                label: "图片";
                on: root.mdl.vision;
                toggled => { root.cap(1, !root.mdl.vision); }
            }
            CapChip {
                label: "语音";
                on: root.mdl.audio;
                toggled => { root.cap(2, !root.mdl.audio); }
            }
            CapChip {
                label: "视频";
                on: root.mdl.video;
                toggled => { root.cap(3, !root.mdl.video); }
            }
            CapChip {
                label: "工具";
                on: root.mdl.tools;
                toggled => { root.cap(4, !root.mdl.tools); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

/// 全屏设置页：顶栏返回 + 左导航四分区。提供商页 = 列表卡 + 详情卡，
/// 字段以 Rust 侧 providers 整包为真相源（in-out 双向链，操作即时回注）；
/// persona 两页存页面级 ed-* 编辑态，底部「保存」一次性提交。
/// 各分区页是 if-block 实例，切页销毁重建。
export component SettingsPage inherits Rectangle {
    // —— 提供商页（Rust 注入/回注；密钥框恒注空，提交空 = 不改已存） ——
    in property <[ProvRow]> provs;
    in-out property <string> prov-sel;      // 正在编辑的条目 id（空 = 无可用）
    in-out property <string> prov-name;
    in-out property <string> prov-base;
    in-out property <string> prov-suffix;
    in-out property <string> prov-key;
    in-out property <int> prov-api;         // 0 chat | 1 responses
    in property <string> sel-kind;          // 当前条目厂商显示名
    in property <bool> sel-locked;          // 定制提供商：接口族锁定
    in property <bool> sel-active;          // 当前条目 = 使用中
    in property <bool> sel-deleted;        // 当前条目已逻辑删除
    in property <string> prov-status;      // 提供商页状态行（测试/保存回显）
    // —— Step B：模型管理 ——
    in property <[ModelRow]> prov-models;
    in property <[RemoteRow]> remote-models;
    in property <bool> remote-loading;
    callback prov-fetch();
    callback prov-model-added(string);
    callback prov-model-custom(string, string);
    callback prov-model-alias(string, string);
    callback prov-model-commit(string); // 「完成」收起后统一回刷标签/下拉
    callback prov-model-cap(string, int, bool);
    callback prov-model-removed(string);
    callback prov-created(int);            // 新增菜单选择：0 通用兼容 | 1 小米 MiMo
    callback prov-selected(string);         // 点列表项 → Rust 回注详情
    callback prov-used();                   // 使用此提供商
    callback prov-saved();                  // 完成（表单写回条目 + 密钥）
    callback prov-deleted();                // 逻辑删除
    callback prov-restored();               // 恢复
    callback prov-purged();                 // 彻底删除（连带清密钥）
    callback prov-tested();                 // 测试连通（用表单当前值）

    // —— AI 助手页（多助手；Rust 注入/回注，表单存页面级 ed 态，「完成」写回） ——
    in property <[AstRow]> asts;
    in-out property <string> ast-sel;       // 正在编辑的助手 id（空 = 无选中）
    in-out property <string> ast-name;
    in-out property <string> ast-prompt;    // 系统提示词（空 = 不注入）
    in-out property <string> ast-temp;      // 温度（空 = 未设定）
    in-out property <string> ast-opening;   // 开场白（空 = 建会话不插）
    in-out property <string> ast-model;     // 默认模型 id（空 = 建会话不切模型）
    in property <string> ast-avatar;        // 头像图片路径（空 = 圆底首字）
    in property <image> ast-avatar-img;     // 已加载头像（空图 width=0）
    in property <color> ast-avatar-color;   // 圆底色（Rust 按 id 哈希取色板）
    in property <string> ast-initial;       // 名称首字（Slint string 无 substring，Rust 注入）
    in property <bool> sel-ast-default;     // 当前选中 = 默认助手（不可删）
    in property <bool> sel-ast-deleted;
    in property <string> ast-status;
    in property <[ModelItem]> ast-models;   // 默认模型弹层数据源（当前激活提供商模型）
    callback ast-created();
    callback ast-selected(string);
    callback ast-saved();                   // 「完成」：表单写回选中助手
    callback ast-deleted();
    callback ast-restored();
    callback ast-purged();
    callback ast-defaulted();               // 设为默认助手
    callback ast-avatar-picked();           // 弹系统文件对话框选图
    callback ast-avatar-cleared();

    // —— 用户设定页 + 界面页无需回写（主题走 Theme 全局） ——
    in property <string> init-user-persona; // 用户人设（persona user）
    in property <string> status;
    callback saved(string);                 // 用户人设（助手字段已迁 AI 助手页）
    callback back();

    // 0 界面（默认）| 1 提供商 | 2 AI 助手 | 3 用户设定
    property <int> page: 0;
    property <bool> add-menu: false;        // 新增提供商弹层
    property <bool> remote-open: false;     // 远端模型清单弹层（拉取按钮开启，遮罩关闭）
    property <bool> custom-open: false;     // 自定义模型输入行（「自定义」按钮开合）
    property <string> mdl-edit: "";         // 正在编辑的模型行 id（同屏仅一行）
    property <bool> ast-model-open: false;  // 默认模型选择弹层

    // 编辑态（用户人设跨页存续）：初值 = 注入的落盘配置
    in-out property <string> ed-persona: root.init-user-persona;

    background: Theme.p.windowBg;
    clip: true;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            // —— 左：分类导航卡（返回置顶；宽度随窗口收放） ——
            Card {
                width: Math.max(104px, Math.min(150px, root.width * 0.14));
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    // 返回 + 「设置」标题并排一行（返回在左，钮缩小）
                    HorizontalLayout {
                        height: 26px;
                        spacing: 6px;
                        BackButton {
                            width: 58px;
                            clicked => { root.back(); }
                        }
                        Text {
                            text: "设置";
                            color: Theme.p.textPrimary;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                    NavItem {
                        label: "界面";
                        selected: root.page == 0;
                        picked => { root.page = 0; }
                    }
                    NavItem {
                        label: "提供商";
                        selected: root.page == 1;
                        picked => { root.page = 1; }
                    }
                    NavItem {
                        label: "AI 助手";
                        selected: root.page == 2;
                        picked => { root.page = 2; }
                    }
                    NavItem {
                        label: "用户设定";
                        selected: root.page == 3;
                        picked => { root.page = 3; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // —— 提供商页：列表卡 + 详情卡（Rust 为真相源，操作即时回注） ——
            if root.page == 1 : HorizontalLayout {
                spacing: 10px;
                // if-block 子元素不自动占位：无此行则不随窗口撑满
                horizontal-stretch: 1;

                prov-list := Card {
                    width: Math.max(120px, Math.min(180px, root.width * 0.17));
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Pill {
                            label: "＋ 新增";
                            picked => { root.add-menu = true; }
                        }
                        for pr in root.provs : ProvItemRow {
                            name: pr.name;
                            kind: pr.kind;
                            active: pr.active;
                            deleted: pr.deleted;
                            current: pr.id == root.prov-sel;
                            clicked => {
                                root.prov-selected(pr.id);
                                root.mdl-edit = "";
                                root.custom-open = false;
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                    // 新增弹层：卡内锚「＋ 新增」正下方（后于布局声明 = 盖在上层）
                    if root.add-menu : Rectangle {
                        x: 6px;
                        y: 42px;
                        width: parent.width - 12px;
                        height: 76px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.p.inputBorder;
                        background: Theme.p.panelBg;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 0;
                            MenuOpt {
                                label: "自定义";
                                picked => {
                                    root.add-menu = false;
                                    root.prov-created(0);
                                }
                            }
                            MenuOpt {
                                label: "Xiaomi MiMo";
                                picked => {
                                    root.add-menu = false;
                                    root.prov-created(1);
                                }
                            }
                        }
                    }
                }

                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        // 表单主体整体可滚：窗口过矮时滚动可见全部内容（底栏按钮不随滚）；
                        // 模型列表随内容增高，不再 stretch 成大片空框
                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.visible-width;
                            horizontal-scrollbar-policy: always-off;
                            vertical-scrollbar-policy: always-on;
                            VerticalLayout {
                                spacing: 10px;

                                Text {
                                    text: root.prov-sel == "" ? "提供商"
                                        : (root.sel-deleted ? "已删除的提供商" : "编辑提供商");
                                    color: Theme.p.textPrimary;
                                    font-size: 14px;
                                }

                                if root.prov-sel == "" : Text {
                                    text: "还没有可用的提供商：点左上「＋ 新增」创建第一个。";
                                    color: Theme.p.textMuted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                if root.prov-sel != "" : FieldRow {
                                    label: "显示名（留空 = 用厂商标签）";
                                    text <=> root.prov-name;
                                    hint: root.sel-kind;
                                }
                                // 基础地址与路径后缀并排（2:1 分宽）
                                if root.prov-sel != "" : HorizontalLayout {
                                    spacing: 8px;
                                    height: 52px;
                                    FieldRow {
                                        horizontal-stretch: 2;
                                        label: "基础地址（custom 必填；定制厂商留空 = 内置端点）";
                                        text <=> root.prov-base;
                                        hint: "https://api.openai.com/v1";
                                    }
                                    FieldRow {
                                        horizontal-stretch: 1;
                                        label: "路径后缀（可选）";
                                        text <=> root.prov-suffix;
                                        hint: "如 proxy/aigw，可留空";
                                    }
                                }
                                if root.prov-sel != "" : FieldRow {
                                    label: "API 密钥（留空 = 保持已存值不变；只存 config.toml，不进 DB）";
                                    text <=> root.prov-key;
                                    hint: "sk-...";
                                }

                                if root.prov-sel != "" : Text {
                                    text: "接入方案";
                                    color: Theme.p.textMuted;
                                    font-size: 12px;
                                }
                                if root.prov-sel != "" && !root.sel-locked : HorizontalLayout {
                                    spacing: 8px;
                                    height: 30px;
                                    Pill {
                                        width: 120px;
                                        label: "chat";
                                        selected: root.prov-api == 0;
                                        picked => { root.prov-api = 0; }
                                    }
                                    Pill {
                                        width: 120px;
                                        label: "responses";
                                        selected: root.prov-api == 1;
                                        picked => { root.prov-api = 1; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.prov-sel != "" && root.sel-locked : Text {
                                    text: "responses（定制提供商锁定）";
                                    color: Theme.p.textSecondary;
                                    font-size: 13px;
                                }

                                // —— Step B/C：模型管理 ——
                                // 模型框是弹性区：最少两行、最大吃满富余高（框内自滚），
                                // 其余元素恒全显；窗口矮于内容最小高时外层 ScrollView 才可滚
                                if root.prov-sel != "" && !root.sel-deleted : VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "可用模型";
                                        color: Theme.p.textMuted;
                                        font-size: 12px;
                                    }
                                    Rectangle {
                                        min-height: 128px; // 两行模型（58 行高+2 间距+padding）
                                        vertical-stretch: 1;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: Theme.p.inputBorder;
                                        background: Theme.p.windowBg;
                                        clip: true;
                                        if root.prov-models.length == 0 : Text {
                                            text: "还没有模型：右下「拉取远端」或「自定义」添加。";
                                            color: Theme.p.textMuted;
                                            font-size: 12px;
                                            x: 8px;
                                            y: 8px;
                                            wrap: word-wrap;
                                            width: parent.width - 16px;
                                        }
                                        ScrollView {
                                            width: parent.width;
                                            height: parent.height;
                                            viewport-width: self.visible-width;
                                            viewport-height: root.prov-models.length * 60px + 6px;
                                            VerticalLayout {
                                                padding: 4px;
                                                spacing: 2px;
                                                for m in root.prov-models : ModelCard {
                                                    mdl: m;
                                                    editing: root.mdl-edit != "" && root.mdl-edit == m.id;
                                                    edit-requested => { root.mdl-edit = m.id; }
                                                    edit-done => {
                                                        root.mdl-edit = "";
                                                        root.prov-model-commit(m.id);
                                                    }
                                                    alias-changed(a) => { root.prov-model-alias(m.id, a); }
                                                    cap(which, on) => { root.prov-model-cap(m.id, which, on); }
                                                    remove-request => { root.prov-model-removed(m.id); }
                                                }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 30px;
                                        Pill {
                                            width: 88px;
                                            label: "测试连通";
                                            picked => { root.prov-tested(); }
                                        }
                                        // 测试/操作结果就地回显在按钮右侧（超长省略号）
                                        if root.prov-status != "" : Text {
                                            horizontal-stretch: 1;
                                            text: root.prov-status;
                                            color: Theme.p.link;
                                            font-size: 12px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        if root.prov-status == "" : Rectangle { horizontal-stretch: 1; }
                                        Pill {
                                            width: 72px;
                                            label: "自定义";
                                            selected: root.custom-open;
                                            picked => { root.custom-open = !root.custom-open; }
                                        }
                                        Pill {
                                            width: 84px;
                                            label: "拉取远端";
                                            selected: root.remote-loading;
                                            picked => {
                                                root.remote-open = true;
                                                root.prov-fetch();
                                            }
                                        }
                                    }
                                    // 自定义输入行（「自定义」按钮开合；新建即一条普通模型，与拉取殊途同归）
                                    if root.custom-open : HorizontalLayout {
                                        spacing: 6px;
                                        height: 26px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            min-width: 100px;
                                            border-radius: 5px;
                                            border-width: 1px;
                                            border-color: Theme.p.inputBorder;
                                            background: Theme.p.windowBg;
                                            ci := TextInput {
                                                x: 6px;
                                                y: 0;
                                                width: parent.width - 12px;
                                                height: parent.height;
                                                vertical-alignment: center;
                                                single-line: true;
                                                font-size: 12px;
                                                color: Theme.p.textPrimary;
                                                selection-background-color: Theme.p.accentSoftBg;
                                            }
                                            Text {
                                                visible: ci.text == "";
                                                x: 6px;
                                                y: 0;
                                                height: parent.height;
                                                vertical-alignment: center;
                                                text: "模型请求 ID";
                                                color: Theme.p.textMuted;
                                                font-size: 12px;
                                            }
                                        }
                                        Rectangle {
                                            width: Math.max(90px, root.width * 0.1);
                                            border-radius: 5px;
                                            border-width: 1px;
                                            border-color: Theme.p.inputBorder;
                                            background: Theme.p.windowBg;
                                            ca := TextInput {
                                                x: 6px;
                                                y: 0;
                                                width: parent.width - 12px;
                                                height: parent.height;
                                                vertical-alignment: center;
                                                single-line: true;
                                                font-size: 12px;
                                                color: Theme.p.textPrimary;
                                                selection-background-color: Theme.p.accentSoftBg;
                                            }
                                            Text {
                                                visible: ca.text == "";
                                                x: 6px;
                                                y: 0;
                                                height: parent.height;
                                                vertical-alignment: center;
                                                text: "别名（可选）";
                                                color: Theme.p.textMuted;
                                                font-size: 12px;
                                            }
                                        }
                                        Pill {
                                            width: 48px;
                                            label: "添加";
                                            primary: true;
                                            picked => {
                                                root.prov-model-custom(ci.text, ca.text);
                                                ci.text = "";
                                                ca.text = "";
                                                root.custom-open = false;
                                            }
                                        }
                                    }
                                }

                                // 已删条目专属反馈行（模型框内状态随块隐藏，这里补位）
                                if root.sel-deleted && root.prov-status != "" : Text {
                                    text: root.prov-status;
                                    color: Theme.p.link;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                // 尾部 filler 仅在模型区隐藏时补位（防定高子项摊开）；
                                // 模型区可见时富余高归模型框独吞
                                if root.prov-sel == "" || root.sel-deleted : Rectangle { vertical-stretch: 1; }
                            }
                        }

                        // 按钮行（固定底栏，不随主体滚动）：删除类恒左，动效项右（「完成」最右）
                        if root.prov-sel != "" : HorizontalLayout {
                            spacing: 8px;
                            height: 30px;
                            Pill {
                                width: 72px;
                                label: root.sel-deleted ? "彻底删除" : "删除";
                                picked => {
                                    if root.sel-deleted {
                                        root.prov-purged();
                                    } else {
                                        root.prov-deleted();
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if !root.sel-deleted && !root.sel-active : Pill {
                                width: 108px;
                                label: "使用此提供商";
                                picked => { root.prov-used(); }
                            }
                            if root.sel-deleted : Pill {
                                width: 72px;
                                label: "恢复";
                                picked => { root.prov-restored(); }
                            }
                            if !root.sel-deleted : Pill {
                                width: 72px;
                                label: "完成";
                                primary: true;
                                picked => { root.prov-saved(); }
                            }
                        }
                    }
                }
            }

            // —— AI 助手页：列表卡 + 详情卡（Rust 为真相源，「完成」写回） ——
            if root.page == 2 : HorizontalLayout {
                spacing: 10px;
                // if-block 子元素不自动占位：无此行则不随窗口撑满
                horizontal-stretch: 1;

                Card {
                    width: Math.max(120px, Math.min(180px, root.width * 0.17));
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Pill {
                            label: "＋ 新增";
                            picked => { root.ast-created(); }
                        }
                        for a in root.asts : ProvItemRow {
                            name: a.name;
                            kind: a.sub;
                            active: a.active;
                            active-label: "● 默认";
                            deleted: a.deleted;
                            current: a.id == root.ast-sel;
                            clicked => {
                                root.ast-selected(a.id);
                                root.ast-model-open = false;
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.visible-width;
                            horizontal-scrollbar-policy: always-off;
                            vertical-scrollbar-policy: always-on;
                            VerticalLayout {
                                spacing: 10px;

                                Text {
                                    text: root.ast-sel == "" ? "AI 助手"
                                        : (root.sel-ast-deleted ? "已删除的助手" : "编辑助手");
                                    color: Theme.p.textPrimary;
                                    font-size: 14px;
                                }

                                if root.ast-sel == "" : Text {
                                    text: "没有选中的助手：点左上「＋ 新增」创建。";
                                    color: Theme.p.textMuted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                // 头像行：圆形预览（有图盖图，无图圆底+首字）+ 选图/清除
                                if root.ast-sel != "" : HorizontalLayout {
                                    spacing: 10px;
                                    height: 52px;
                                    Rectangle {
                                        width: 48px;
                                        height: 48px;
                                        border-radius: 24px;
                                        clip: true;
                                        background: root.ast-avatar-color;
                                        if root.ast-avatar-img.width > 0 : Image {
                                            width: 48px;
                                            height: 48px;
                                            source: root.ast-avatar-img;
                                            image-fit: cover;
                                        }
                                        if root.ast-avatar-img.width == 0 : Text {
                                            width: 48px;
                                            height: 48px;
                                            text: root.ast-initial;
                                            color: white;
                                            font-size: 20px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        vertical-stretch: 0;
                                        spacing: 4px;
                                        Text {
                                            text: "头像（无图 = 圆底 + 名称首字）";
                                            color: Theme.p.textMuted;
                                            font-size: 12px;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            height: 26px;
                                            Pill {
                                                width: 76px;
                                                label: "选图片…";
                                                picked => { root.ast-avatar-picked(); }
                                            }
                                            if root.ast-avatar != "" : Pill {
                                                width: 48px;
                                                label: "清除";
                                                picked => { root.ast-avatar-cleared(); }
                                            }
                                            if root.ast-avatar != "" : Text {
                                                horizontal-stretch: 1;
                                                text: root.ast-avatar;
                                                color: Theme.p.textMuted;
                                                font-size: 11px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            if root.ast-avatar == "" : Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }

                                if root.ast-sel != "" : FieldRow {
                                    label: "名称";
                                    text <=> root.ast-name;
                                    hint: "例如：翻译助手";
                                }
                                if root.ast-sel != "" : PromptRow {
                                    label: "系统提示词（每次发送前置注入，留空 = 不发）";
                                    text <=> root.ast-prompt;
                                    hint: "例如：你是 oWakaka，回答简洁，中文，代码优先";
                                }
                                if root.ast-sel != "" : FieldRow {
                                    label: "温度（0–2；留空 = 不发送该字段，跟随网关默认）";
                                    text <=> root.ast-temp;
                                    hint: "0.7";
                                }
                                if root.ast-sel != "" : PromptRow {
                                    label: "开场白（用该助手新建会话时作为第一条助手消息，留空 = 不插）";
                                    text <=> root.ast-opening;
                                    hint: "例如：你好，我是你的翻译助手，发文本即译";
                                }
                                if root.ast-sel != "" : VerticalLayout {
                                    vertical-stretch: 0;
                                    spacing: 3px;
                                    Text {
                                        text: "默认模型（新建会话时自动切模型下拉；不指定 = 保持当前选择）";
                                        color: Theme.p.textMuted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 30px;
                                        Pill {
                                            width: 180px;
                                            label: root.ast-model == "" ? "不指定" : root.ast-model;
                                            picked => { root.ast-model-open = true; }
                                        }
                                        if root.ast-status != "" : Text {
                                            horizontal-stretch: 1;
                                            text: root.ast-status;
                                            color: Theme.p.link;
                                            font-size: 12px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        if root.ast-status == "" : Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                                // 尾部惰性 filler：定高内容上靠，高窗富余不被摊开
                                Rectangle { vertical-stretch: 1; }
                            }
                        }

                        // 底栏（不随主体滚动）：删除类恒左，「设为默认」「完成」靠右
                        if root.ast-sel != "" : HorizontalLayout {
                            spacing: 8px;
                            height: 30px;
                            if root.sel-ast-deleted : Pill {
                                width: 72px;
                                label: "彻底删除";
                                picked => { root.ast-purged(); }
                            }
                            if !root.sel-ast-deleted && !root.sel-ast-default : Pill {
                                width: 72px;
                                label: "删除";
                                picked => { root.ast-deleted(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if root.sel-ast-deleted : Pill {
                                width: 72px;
                                label: "恢复";
                                picked => { root.ast-restored(); }
                            }
                            if !root.sel-ast-deleted && !root.sel-ast-default : Pill {
                                width: 96px;
                                label: "设为默认";
                                picked => { root.ast-defaulted(); }
                            }
                            if !root.sel-ast-deleted : Pill {
                                width: 72px;
                                label: "完成";
                                primary: true;
                                picked => { root.ast-saved(); }
                            }
                        }
                    }
                }
            }

            // —— 其余分区：单内容卡 ——
            if root.page == 0 || root.page == 3 : Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    Text {
                        text: root.page == 0 ? "界面" : "用户设定";
                        color: Theme.p.textPrimary;
                        font-size: 14px;
                    }

                    if root.page == 0 : VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: "主题";
                            color: Theme.p.textMuted;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            height: 30px;
                            Rectangle { horizontal-stretch: 1; }
                            Pill {
                                width: 110px;
                                label: "浅色";
                                selected: Theme.mode == 0;
                                picked => { Theme.mode = 0; }
                            }
                            Pill {
                                width: 110px;
                                label: "深色";
                                selected: Theme.mode == 1;
                                picked => { Theme.mode = 1; }
                            }
                            Pill {
                                width: 130px;
                                label: "跟随系统";
                                selected: Theme.mode == 2;
                                picked => { Theme.mode = 2; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            text: "主题即时生效（与侧栏主题菜单同源），自动持久化，重启保留";
                            color: Theme.p.textMuted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    if root.page == 3 : VerticalLayout {
                        spacing: 10px;
                        PromptRow {
                            label: "用户人设（并入 system 消息的【用户人设】段，可留空）";
                            text <=> root.ed-persona;
                            hint: "例如：资深 Rust 工程师，关注架构与成本";
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // visible 只免渲染不免布局占位（1.17 编译器实证）→ 条件子项必须用 if 块才真正让出空间
        if root.status != "" && root.page != 1 : Text {
            text: root.status;
            color: Theme.p.link;
            font-size: 12px;
            wrap: word-wrap;
        }

        // 全局「保存」只服务用户设定页；提供商/AI 助手页在详情卡内保存
        if root.page == 3 : HorizontalLayout {
            spacing: 8px;
            height: 30px;
            Rectangle { horizontal-stretch: 1; }
            Pill {
                width: 88px;
                label: "保存";
                primary: true;
                picked => {
                    root.saved(root.ed-persona);
                }
            }
        }
    }

    // —— 远端模型清单弹层：居中自适应（＋收录；已收录 ✓ 灰显，遮罩关闭） ——
    if root.remote-open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        TouchArea {
            clicked => { root.remote-open = false; }
        }
    }
    if root.remote-open : Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: Math.min(360px, root.width - 60px);
        height: Math.min(440px, root.height - 60px);
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.p.inputBorder;
        background: Theme.p.panelBg;
        clip: true;
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            HorizontalLayout {
                height: 24px;
                spacing: 8px;
                Text {
                    text: "远端模型清单";
                    color: Theme.p.textPrimary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Pill {
                    width: 56px;
                    label: "关闭";
                    picked => { root.remote-open = false; }
                }
            }
            if root.remote-loading : Text {
                text: "拉取中…（改地址/密钥后请重开设置再拉）";
                color: Theme.p.textMuted;
                font-size: 12px;
                wrap: word-wrap;
            }
            if !root.remote-loading && root.remote-models.length == 0 : Text {
                text: "暂无清单：点「拉取远端」按当前表单的端点与密钥请求 /models。";
                color: Theme.p.textMuted;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.p.inputBorder;
                background: Theme.p.windowBg;
                clip: true;
                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.visible-width;
                    vertical-scrollbar-policy: always-on;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        for r in root.remote-models : HorizontalLayout {
                            height: 26px;
                            spacing: 6px;
                            Text {
                                text: r.id;
                                horizontal-stretch: 1;
                                color: r.added ? Theme.p.textMuted : Theme.p.textPrimary;
                                font-size: 12px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Pill {
                                width: 44px;
                                label: r.added ? "✓" : "＋";
                                selected: !r.added;
                                picked => {
                                    if !r.added { root.prov-model-added(r.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // —— 默认模型选择弹层：居中自适应（数据源 = 当前激活提供商模型清单，含「不指定」） ——
    if root.ast-model-open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        TouchArea {
            clicked => { root.ast-model-open = false; }
        }
    }
    if root.ast-model-open : Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: Math.min(320px, root.width - 60px);
        height: Math.min(360px, root.height - 60px);
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.p.inputBorder;
        background: Theme.p.panelBg;
        clip: true;
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            HorizontalLayout {
                height: 24px;
                spacing: 8px;
                Text {
                    text: "默认模型";
                    color: Theme.p.textPrimary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Pill {
                    width: 56px;
                    label: "关闭";
                    picked => { root.ast-model-open = false; }
                }
            }
            if root.ast-models.length == 0 : Text {
                text: "当前提供商还没有登记模型：先去提供商页添加。";
                color: Theme.p.textMuted;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.p.inputBorder;
                background: Theme.p.windowBg;
                clip: true;
                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.visible-width;
                    vertical-scrollbar-policy: always-on;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        MenuOpt {
                            label: "不指定";
                            picked => {
                                root.ast-model = "";
                                root.ast-model-open = false;
                            }
                        }
                        for m in root.ast-models : MenuOpt {
                            label: m.display;
                            picked => {
                                root.ast-model = m.id;
                                root.ast-model-open = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
