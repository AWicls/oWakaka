// 回收站浮层（会话两级删除的找回入口）：通用 Modal 的对话域消费方。
// 遮罩只盖内容区——定位（y=caption-height 之下、铺满 content 区）由使用方 AppWindow 绑定。

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Pill, Modal } from "./controls.slint";

/// 回收站一行（逻辑删除的会话）
export struct TrashItem {
    id: int,
    title: string,
}

/// 回收站浮层：遮罩（点击关闭）+ 居中卡（恢复 / 彻底删除）
export component TrashOverlay inherits Modal {
    in property <[TrashItem]> items;
    callback close-overlay();
    callback restore(int);
    callback purge(int);

    title: "回收站";
    card-max-height: 420px;
    close-requested => { root.close-overlay(); }

    if root.items.length == 0 : Text {
        text: "没有已删除的会话。侧栏条目悬停后点行右侧的叉号，删掉的会话会先进这里。";
        color: Theme.p.textMuted;
        font-size: 12px;
        wrap: word-wrap;
    }
    ScrollView {
        vertical-stretch: 1;
        viewport-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            spacing: 4px;
            for t in root.items : HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Text {
                    text: t.title;
                    horizontal-stretch: 1;
                    color: Theme.p.textSecondary;
                    font-size: 13px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Pill {
                    width: self.hug-width;
                    btn-height: 22px;
                    label: "恢复";
                    picked => { root.restore(t.id); }
                }
                Pill {
                    width: self.hug-width;
                    btn-height: 22px;
                    danger: true;
                    label: "彻底删除";
                    picked => { root.purge(t.id); }
                }
            }
        }
    }
    Text {
        text: "恢复 = 放回侧栏末尾；彻底删除连同全部消息物理清除，不可找回。";
        color: Theme.p.textMuted;
        font-size: 11px;
        wrap: word-wrap;
    }
}
